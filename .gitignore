# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore,
# Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/
*.xcuserstate

## Xcode generated
DerivedData/
.build/
Build/
*.xcscmblueprint
*.xccheckout

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM
*.dSYM.zip

## Playground
timeline.xctimeline
playground.xcworkspace

## Swift Package Manager
#
# Keep Package.swift and Package.resolved if they are part of your
# project's reproducible dependency setup.
#
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Xcode automatically generates this directory with a .xcworkspacedata
# file and xcuserdata.
#
# .swiftpm/

## CocoaPods
#
# If you use CocoaPods, decide whether Pods/ should be committed.
#
# Pods/
# *.xcworkspace

## Carthage
Carthage/Build/

## fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

## macOS
.DS_Store
.AppleDouble
.LSOverride
._*

## macOS generated files
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.fseventsd

## Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

## Archives
*.xcarchive

## Secrets / local configuration
.env
.env.*
!.env.example

*.p12
*.mobileprovision
*.provisionprofile

## IDE / editor
.vscode/
.idea/

## Local Swift / Xcode configuration
*.xcuserdatad
