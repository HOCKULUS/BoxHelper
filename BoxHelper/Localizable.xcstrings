    "Can I edit or use my backup data outside the app?" : {
      "comment" : "Question about accessing and editing backup data externally",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يمكنني تعديل أو استخدام بيانات النسخة الاحتياطية خارج التطبيق؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি কি অ্যাপের বাইরে আমার ব্যাকআপ ডেটা সম্পাদনা বা ব্যবহার করতে পারি?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mohu svá záložní data upravovat nebo používat mimo aplikaci?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
