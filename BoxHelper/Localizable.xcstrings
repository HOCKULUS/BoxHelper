          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz do testów beta, aby wcześniej uzyskać dostęp do nowych funkcji lub odpowiedzi na swoje pytania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
