    "Create a box named ${boxName} at location ${location} with the items ${newItems}" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنشاء صندوق باسم ${boxName} في الموقع ${location} مع العناصر ${newItems}"
          }
        },
        "bn" : {
