          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delta i betatestet för att få tidig tillgång till nya funktioner eller svar på dina frågor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni özelliklere erken erişmek veya sorularınıza cevap almak için beta testine katılın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
