    "There was a problem processing the link you opened. Please check if the link is correct and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدثت مشكلة أثناء معالجة الرابط الذي فتحته. يرجى التحقق من صحة الرابط والمحاولة مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যে লিঙ্কটি খুলেছেন তা প্রক্রিয়াকরণে একটি সমস্যা হয়েছে। অনুগ্রহ করে লিঙ্কটি সঠিক কিনা যাচাই করে আবার চেষ্টা করুন।"
