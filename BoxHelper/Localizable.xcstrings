    "Anschließend wählst du im iCloud-Dialog die Teilnehmenden aus. Die Einladung verwendet die gewählten Zugriffsrechte." : {
      "comment" : "A description of the next step after the user creates an inventory share.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثم حدد المشاركين في مربع حوار iCloud. تستخدم الدعوة أذونات الوصول المحددة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তারপর iCloud ডায়ালগে অংশগ্রহণকারীদের নির্বাচন করুন। আমন্ত্রণে নির্বাচিত অ্যাক্সেস পারমিশন ব্যবহার করা হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poté vyber účastníky v dialogu iCloudu. Pozvánka použije zvolená přístupová práva."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg derefter deltagerne i iCloud-dialogen. Invitationen bruger de valgte adgangsrettigheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anschließend wählst du im iCloud-Dialog die Teilnehmenden aus. Die Einladung verwendet die gewählten Zugriffsrechte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then select participants in the iCloud dialog. The invitation uses the selected access permissions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then select participants in the iCloud dialog. The invitation uses the selected access permissions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después, selecciona los participantes en el diálogo de iCloud. La invitación utilizará los permisos de acceso elegidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionne ensuite les participants dans la fenêtre iCloud. L’invitation utilisera les droits d’accès choisis."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionne ensuite les participants dans la fenêtre iCloud. L’invitation utilisera les droits d’accès choisis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके बाद iCloud संवाद में प्रतिभागी चुनें। निमंत्रण में चुनी गई पहुँच अनुमतियाँ इस्तेमाल होंगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi seleziona i partecipanti nella finestra di iCloud. L’invito utilizzerà i permessi di accesso scelti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続いて iCloud のダイアログで参加者を選択します。招待には選択したアクセス権が使用されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer daarna de deelnemers in het iCloud-venster. De uitnodiging gebruikt de gekozen toegangsrechten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Następnie wybierz uczestników w oknie iCloud. Zaproszenie użyje wybranych uprawnień dostępu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois, seleciona os participantes na janela do iCloud. O convite utiliza as permissões de acesso escolhidas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj sedan deltagarna i iCloud-dialogen. Inbjudan använder de valda åtkomsträttigheterna."
          }
        },
