    "Lege fest, wie sich die App verhält und passe ihre Darstellung an deine Bedürfnisse an." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد كيف يتصرف التطبيق وخصص مظهره وفق احتياجاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ কীভাবে আচরণ করবে তা নির্ধারণ করুন এবং আপনার প্রয়োজন অনুযায়ী এর চেহারা সামঞ্জস্য করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte chování aplikace a přizpůsobte její vzhled svým potřebám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestem, hvordan appen opfører sig, og tilpas dens udseende til dine behov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wie sich die App verhält und passe ihre Darstellung an deine Bedürfnisse an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define how the app behaves and adjust its appearance to suit your needs."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define how the app behaves and adjust its appearance to suit your needs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define cómo debe comportarse la app y adapta su apariencia a tus necesidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez le comportement de l’app et adaptez son affichage à vos besoins."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez le comportement de l’app et adaptez son affichage à vos besoins."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तय करें कि ऐप कैसे व्यवहार करे और अपनी ज़रूरतों के अनुसार उसका रूप बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definisci come deve comportarsi l’app e adatta il suo aspetto alle tue esigenze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの動作を設定し、表示を自分の使い方に合わせて調整します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaal hoe de app zich gedraagt en pas de weergave aan je behoeften aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Określ, jak aplikacja ma się zachowywać, i dopasuj jej wygląd do swoich potrzeb."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina o comportamento da aplicação e ajuste a sua apresentação às suas necessidades."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestäm hur appen fungerar och anpassa utseendet efter dina behov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın davranışını belirleyin ve görünümünü ihtiyaçlarınıza göre ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
