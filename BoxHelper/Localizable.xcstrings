        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrátí ID umístění přes krabici položky, nebo žádnou hodnotu, pokud umístění není přiřazeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
