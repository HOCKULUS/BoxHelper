    "How can I share my Boxes with friends and family?" : {
      "comment" : "Question about sharing boxes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف يمكنني مشاركة صناديقي مع العائلة والأصدقاء؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি কীভাবে আমার বাক্সগুলো বন্ধু ও পরিবারের সাথে শেয়ার করতে পারি?"
