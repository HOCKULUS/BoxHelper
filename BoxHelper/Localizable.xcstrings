    "Para saber si el esfuerzo, los costes continuos y mi tiempo realmente valen la pena, dependo de tus comentarios." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكي أعرف ما إذا كان هذا الجهد والتكاليف المستمرة ووقتي يستحقون حقاً، فأنا أعتمد على ملاحظاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পরিশ্রম, চলমান খরচ এবং আমার সময় সত্যিই সার্থক কি না তা জানতে আমি আপনার মতামতের উপর নির্ভর করি।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abych věděl, zda úsilí, průběžné náklady a můj čas opravdu stojí za to, závisím na vaší zpětné vazbě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at vide, om indsatsen, de løbende omkostninger og min tid virkelig er det værd, er jeg afhængig af din feedback."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit ich weiß, ob sich der Aufwand, die laufenden Kosten und meine Zeit lohnen, bin ich auf dein Feedback angewiesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para saber si el esfuerzo, los costes continuos y mi tiempo realmente valen la pena, dependo de tus comentarios."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para saber si el esfuerzo, los costes continuos y mi tiempo realmente valen la pena, dependo de tus comentarios."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para saber si el esfuerzo, los costes continuos y mi tiempo realmente valen la pena, dependo de tus comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour savoir si l’effort, les coûts permanents et mon temps en valent vraiment la peine, je dépends de vos retours."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour savoir si l’effort, les coûts permanents et mon temps en valent vraiment la peine, je dépends de vos retours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह समझने के लिए कि मेहनत, लगातार होने वाली लागतें और मेरा समय वास्तव में सार्थक हैं या नहीं, मैं आपकी प्रतिक्रिया पर निर्भर हूँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per sapere se l’impegno, i costi continui e il mio tempo valgono davvero la pena, dipendo dal tuo feedback."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "費やしている労力、継続コスト、そして時間に見合う価値があるかを知るために、皆さんのフィードバックが必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om te weten of de inspanning, de doorlopende kosten en mijn tijd echt de moeite waard zijn, ben ik afhankelijk van jouw feedback."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wiedzieć, czy ten wysiłek, bieżące koszty i mój czas naprawdę są tego warte, potrzebuję Twojej opinii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para saber si el esfuerzo, los costes continuos y mi tiempo realmente valen la pena, dependo de tus comentarios."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att veta om arbetet, de löpande kostnaderna och min tid är värda det är jag beroende av din återkoppling."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çabanın, devam eden masrafların ve zamanımın karşılığını verip vermediğini anlamak için geri bildirimlerinize ihtiyaç duyuyorum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб зрозуміти, чи справді варті зусилля, постійні витрати та мій час, я залежу від ваших відгуків."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了让我知道这些投入、持续成本和时间是否真的值得，我非常依赖你的反馈。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了了解這些投入、持續成本和我的時間是否真的值得，我需要你的回饋。"
          }
        }
      }
    },
