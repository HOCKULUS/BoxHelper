    "Generate PNG QR codes for multiple boxes. Returns image files for saving, sharing, or printing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنشاء رموز QR بصيغة PNG لعدة صناديق. تُرجع ملفات صور للحفظ أو المشاركة أو الطباعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একাধিক বাক্সের জন্য PNG QR কোড তৈরি করে। সংরক্ষণ, শেয়ার বা প্রিন্ট করার জন্য ছবির ফাইল ফেরত দেয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vygeneruje QR kódy ve formátu PNG pro více krabic. Vrátí obrázkové soubory k uložení, sdílení nebo tisku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genererer QR-koder som PNG til flere kasser. Returnerer billedfiler, der kan gemmes, deles eller udskrives."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeuge PNG-QR-Codes für mehrere Kisten. Gibt Bilddateien zum Speichern, Teilen oder Drucken zurück."
          }
        },
