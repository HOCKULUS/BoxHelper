    "Launch5.Forms.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصبحت إضافة المواقع والعناصر أسهل من أي وقت مضى. تساعدك النماذج الجديدة على ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অবস্থান ও আইটেম যোগ করা এত সহজ কখনো ছিল না। নতুন ফর্মগুলো আপনাকে সাহায্য করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidávání umístění a položek nikdy nebylo snazší. Pomohou ti nové formuláře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det har aldrig været nemmere at tilføje placeringer og genstande. De nye formularer hjælper dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standorte und Gegenstände anlegen war noch nie so einfach. Die neuen Formulare helfen dir dabei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding locations and items has never been easier. The new forms help you get it done."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding locations and items has never been easier. The new forms help you get it done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir ubicaciones y objetos nunca ha sido tan fácil. Los nuevos formularios te ayudan a hacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter des emplacements et des objets n’a jamais été aussi simple. Les nouveaux formulaires t’y aident."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter des emplacements et des objets n’a jamais été aussi simple. Les nouveaux formulaires t’y aident."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थान और वस्तुएँ जोड़ना इतना आसान कभी नहीं था। नए फ़ॉर्म इसमें आपकी मदद करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere posizioni e oggetti non è mai stato così semplice. I nuovi moduli ti aiutano a farlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所やアイテムの追加がさらに簡単になりました。新しいフォームが作業を助けます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locaties en items toevoegen was nog nooit zo eenvoudig. De nieuwe formulieren helpen je daarbij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawanie lokalizacji i przedmiotów nigdy nie było łatwiejsze. Pomogą Ci nowe formularze."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar localizações e itens nunca foi tão fácil. Os novos formulários ajudam-te a fazê-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det har aldrig varit enklare att lägga till platser och föremål. De nya formulären hjälper dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum ve öğe eklemek hiç bu kadar kolay olmamıştı. Yeni formlar işinizi kolaylaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додавати місця й предмети ще ніколи не було так просто. Допоможуть нові форми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加位置和物品从未如此轻松。新表单助你快速完成。"
          }
