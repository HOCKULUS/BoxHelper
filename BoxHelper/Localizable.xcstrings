    "By default, the navigation bar is at the top of the screen and hides when scrolling down a list." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتراضياً، يكون شريط التنقل أعلى الشاشة ويختفي عند التمرير إلى أسفل القائمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিফল্টভাবে নেভিগেশন বার স্ক্রিনের উপরে থাকে এবং তালিকায় নিচে স্ক্রল করলে লুকিয়ে যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve výchozím nastavení je navigační lišta nahoře a při posouvání seznamu dolů se skryje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som standard er navigationslinjen øverst på skærmen og skjules, når du ruller ned gennem en liste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig ist die Navigationsleiste oben und wird beim Scrollen ausgeblendet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, the navigation bar is at the top of the screen and hides when scrolling down a list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por defecto, la barra de navegación está arriba y se oculta al desplazarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, la barre de navigation se trouve en haut de l’écran et se masque lors du défilement d’une liste."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, la barre de navigation se trouve en haut de l’écran et se masque lors du défilement d’une liste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट रूप से नेविगेशन बार स्क्रीन के ऊपर होता है और सूची नीचे स्क्रॉल करने पर छिप जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita, la barra di navigazione si trova nella parte superiore dello schermo e si nasconde quando si scorre un elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは、ナビゲーションバーは画面上部にあり、リストを下へスクロールすると隠れます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaard staat de navigatiebalk bovenaan en verdwijnt bij scrollen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie pasek nawigacji znajduje się u góry ekranu i chowa się podczas przewijania listy w dół."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, the navigation bar is at the top of the screen and hides when scrolling down a list."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За замовчуванням панель навігації знаходиться вгорі екрана і ховається під час прокручування списку вниз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预设情況下，导航字段于螢幕顶部，向下滑动清单时会自动隐藏。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設情況下，導航欄位於螢幕頂部，向下滑動清單時會自動隱藏。"
          }
        }
      }
    },
