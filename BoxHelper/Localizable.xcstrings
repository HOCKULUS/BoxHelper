    "Spotlight.SettingsDescription" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفعّل افتراضيًا. ينشر Spotlight الصناديق مع الاسم والموقع والمعرّف الكامل وقائمة جميع العناصر. لا توجد نتائج منفصلة للعناصر أو المواقع. تعثر أسماء العناصر ووسومها أيضًا على الصندوق الذي يحتويها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিফল্টভাবে চালু। Spotlight বাক্সের নাম, অবস্থান, সম্পূর্ণ ID এবং সব আইটেমের তালিকা প্রকাশ করে। আইটেম ও অবস্থানের আলাদা ফলাফল নেই। আইটেমের নাম ও ট্যাগ দিয়েও তাদের বাক্স খুঁজে পাওয়া যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve výchozím nastavení zapnuto. Spotlight zveřejňuje krabice s názvem, umístěním, úplným ID a seznamem všech položek. Položky a umístění nemají samostatné výsledky. Názvy a štítky položek také najdou jejich krabici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slået til som standard. Spotlight offentliggør kasser med navn, placering, fuldt ID og en liste over alle genstande. Genstande og placeringer har ikke separate resultater. Genstandsnavne og mærker finder også den kasse, der indeholder dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig aktiviert. Kisten werden mit Name, Standort, vollständiger ID und einer Liste aller Gegenstände in Spotlight veröffentlicht. Gegenstände und Standorte erhalten keine eigenen Treffer. Auch Gegenstandsnamen und Tags finden die zugehörige Kiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabled by default. Spotlight publishes boxes with their name, location, full ID and a list of all items. Items and locations do not have separate results. Item names and tags also find their containing box."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabled by default. Spotlight publishes boxes with their name, location, full ID and a list of all items. Items and locations do not have separate results. Item names and tags also find their containing box."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado de forma predeterminada. Spotlight publica las cajas con su nombre, ubicación, identificador completo y una lista de todos sus objetos. Los objetos y ubicaciones no tienen resultados propios. Los nombres y etiquetas de los objetos también permiten encontrar su caja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé par défaut. Spotlight publie les boîtes avec leur nom, leur emplacement, leur identifiant complet et la liste de tous leurs objets. Les objets et les emplacements n’ont pas de résultats distincts. Les noms et étiquettes des objets permettent aussi de retrouver leur boîte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé par défaut. Spotlight publie les boîtes avec leur nom, leur emplacement, leur identifiant complet et la liste de tous leurs objets. Les objets et les emplacements n’ont pas de résultats distincts. Les noms et étiquettes des objets permettent aussi de retrouver leur boîte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट रूप से चालू है। Spotlight डिब्बों को उनके नाम, स्थान, पूरे ID और सभी वस्तुओं की सूची के साथ प्रकाशित करता है। वस्तुओं और स्थानों के अलग परिणाम नहीं हैं। वस्तुओं के नाम और टैग से भी उनका डिब्बा मिल जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivo per impostazione predefinita. Spotlight pubblica le scatole con nome, posizione, ID completo e lista di tutti gli oggetti. Oggetti e posizioni non hanno risultati separati. Anche i nomi e le etichette degli oggetti trovano la scatola che li contiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期設定で有効です。Spotlight は箱の名前、場所、完全な ID、すべてのアイテムの一覧を公開します。アイテムと場所には個別の検索結果はありません。アイテム名やタグでも、それらが入った箱を検索できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaard ingeschakeld. Spotlight publiceert dozen met naam, locatie, volledige ID en een lijst van alle items. Items en locaties hebben geen aparte resultaten. Itemnamen en tags vinden ook de doos die ze bevat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie włączone. Spotlight publikuje pudełka z nazwą, lokalizacją, pełnym ID i listą wszystkich przedmiotów. Przedmioty i lokalizacje nie mają osobnych wyników. Nazwy i tagi przedmiotów także pozwalają znaleźć ich pudełko."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativado por predefinição. O Spotlight publica as caixas com o nome, a localização, o ID completo e uma lista de todos os itens. Itens e localizações não têm resultados separados. Os nomes e as etiquetas dos itens também encontram a caixa que os contém."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverat som standard. Spotlight publicerar lådor med namn, plats, fullständigt ID och en lista över alla föremål. Föremål och platser har inga egna resultat. Föremålsnamn och taggar hittar också lådan de tillhör."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak etkin. Spotlight kutuları ad, konum, tam ID ve tüm öğelerin listesiyle yayımlar. Öğeler ve konumlar ayrı sonuçlara sahip değildir. Öğe adları ve etiketleri de bulundukları kutuyu bulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типово ввімкнено. Spotlight публікує коробки з назвою, місцем, повним ID та списком усіх предметів. Предмети й місця не мають окремих результатів. Назви й теги предметів також знаходять коробку, що їх містить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认启用。Spotlight 会发布箱子的名称、位置、完整 ID 和所有物品的列表。物品和位置没有独立搜索结果。物品名称和标签也能找到其所属箱子。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設啓用。Spotlight 會發佈箱子的名稱、位置、完整 ID 和所有物品的列表。物品和位置沒有獨立搜索結果。物品名稱和標籤也能找到其所屬箱子。"
          }
        }
      }
    },
