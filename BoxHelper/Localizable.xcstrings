    "Deletes a box if no items is assigned to it. Also deletes all associated images from the app storage if needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف صندوقاً إذا لم تكن أي عناصر معينة له. ويحذف أيضاً كل الصور المرتبطة من تخزين التطبيق إذا لزم الأمر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যদি কোনো আইটেম যুক্ত না থাকে, তবে একটি বাক্স মুছে দেয়। প্রয়োজনে অ্যাপ স্টোরেজ থেকে সংশ্লিষ্ট সব ছবিও মুছে দেয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaže krabici, pokud k ní nejsou přiřazeny žádné položky. V případě potřeby také smaže všechny související obrázky z úložiště aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter en kasse, hvis der ikke er knyttet genstande til den. Sletter også alle tilknyttede billeder fra appens lager, hvis det er nødvendigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht eine Kiste, wenn ihr keine Gegenstände zugewiesen sind. Löscht bei Bedarf auch alle zugehörigen Bilder aus dem App-Speicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes a box if no items is assigned to it. Also deletes all associated images from the app storage if needed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes a box if no items is assigned to it. Also deletes all associated images from the app storage if needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina una caja si no tiene objetos asignados. También elimina todas las imágenes asociadas del almacenamiento de la app si es necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime une boîte si aucun élément ne lui est attribué. Supprime également toutes les images associées du stockage de l’app si nécessaire."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime une boîte si aucun élément ne lui est attribué. Supprime également toutes les images associées du stockage de l’app si nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि किसी डिब्बे को कोई वस्तु नहीं सौंपी गई है तो उसे हटाता है। आवश्यकता होने पर ऐप स्टोरेज से जुड़े सभी चित्र भी हटा देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina una scatola se non ha elementi assegnati. Elimina anche tutte le immagini associate dall’archivio dell’app, se necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイテムが割り当てられていない箱を削除します。必要に応じて関連画像もアプリの保存領域から削除します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert een doos als er geen items aan zijn toegewezen. Verwijdert indien nodig ook alle bijbehorende afbeeldingen uit de app-opslag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa pudełko, jeśli nie ma do niego przypisanych przedmiotów. W razie potrzeby usuwa też wszystkie powiązane obrazy z pamięci aplikacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes a caixa if no itens is assigned to it. Also deletes all associated imagems from the app storage if needed."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderar en låda om den inte har några föremål. Raderar vid behov också alla tillhörande bilder från appens lagring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
