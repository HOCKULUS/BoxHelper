    "FirstTab.ListLimit.ShowLoadAllButtonDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُظهر زر «تحميل الكل» في أسفل قوائم الصناديق والعناصر والمواقع. عند تعطيل هذا الخيار، تُحمّل جميع العناصر تلقائيًا دون زر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাক্স, আইটেম ও অবস্থানের তালিকার নিচে “সব লোড করুন” বোতাম দেখায়। বন্ধ করলে সব এন্ট্রি বোতাম ছাড়াই স্বয়ংক্রিয়ভাবে লোড হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí tlačítko „Načíst vše“ na konci seznamů krabic, položek a umístění. Po vypnutí se všechny záznamy načtou automaticky bez tlačítka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser “Indlæs alle” nederst i listerne over kasser, genstande og placeringer. Når indstillingen slås fra, indlæses alle poster automatisk uden en knap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt „Alle laden“ am Ende der Listen für Kisten, Gegenstände und Standorte. Beim Deaktivieren werden alle Einträge automatisch ohne Button geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows “Load all” at the bottom of the box, item, and location lists. When disabled, all entries load automatically without a button."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows “Load all” at the bottom of the box, item, and location lists. When disabled, all entries load automatically without a button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra «Cargar todo» al final de las listas de cajas, objetos y ubicaciones. Al desactivar esta opción, todas las entradas se cargan automáticamente sin botón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche « Tout charger » en bas des listes de boîtes, d’objets et d’emplacements. Lorsque cette option est désactivée, toutes les entrées sont chargées automatiquement sans bouton."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche « Tout charger » en bas des listes de boîtes, d’objets et d’emplacements. Lorsque cette option est désactivée, toutes les entrées sont chargées automatiquement sans bouton."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिब्बों, वस्तुओं और स्थानों की सूचियों के अंत में “सभी लोड करें” दिखाता है। यह विकल्प बंद करने पर सभी प्रविष्टियाँ बिना बटन के अपने आप लोड हो जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra “Carica tutto” in fondo agli elenchi di scatole, articoli e luoghi. Disattivando questa opzione, tutte le voci vengono caricate automaticamente senza pulsante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "箱、アイテム、場所のリストの末尾に「すべて読み込む」を表示します。無効にすると、ボタンを使わずにすべての項目が自動的に読み込まれます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont ‘Alles laden’ onderaan de lijsten met dozen, items en locaties. Als deze optie is uitgeschakeld, worden alle vermeldingen automatisch zonder knop geladen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje „Załaduj wszystko” na końcu list pudełek, przedmiotów i lokalizacji. Po wyłączeniu tej opcji wszystkie wpisy są ładowane automatycznie bez przycisku."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra «Carregar tudo» no fim das listas de caixas, itens e localizações. Ao desativar esta opção, todas as entradas são carregadas automaticamente sem botão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar ”Läs in alla” längst ned i listorna över lådor, föremål och platser. När inställningen stängs av läses alla poster in automatiskt utan knapp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutu, öğe ve konum listelerinin sonunda “Tümünü yükle” düğmesini gösterir. Bu seçenek kapatıldığında tüm kayıtlar düğme olmadan otomatik olarak yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує «Завантажити все» внизу списків коробок, предметів і локацій. Коли цю опцію вимкнено, усі записи завантажуються автоматично без кнопки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在箱子、物品和位置列表底部显示“加载全部”。关闭此选项后，所有条目会自动加载，无需按钮。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在箱子、物品和位置清單底部顯示「載入全部」。關閉此選項後，所有項目會自動載入，無需按鈕。"
          }
        }
      }
    },
