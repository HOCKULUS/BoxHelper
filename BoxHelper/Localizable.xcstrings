      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيرت الصور المحددة أو الوجهة. أغلق هذه النافذة وحدد الصور مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্বাচিত ছবি বা গন্তব্য বদলে গেছে। এই উইন্ডো বন্ধ করুন এবং ছবিগুলো আবার বেছে নিন।"
