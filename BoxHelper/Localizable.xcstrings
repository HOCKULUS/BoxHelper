    "Trash.Explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُزال البيانات المحذوفة من قاعدة البيانات فورًا. يمكنك استعادة نسختها الاحتياطية هنا حتى انتهاء مدة الاحتفاظ. تُنظّف النسخ المنتهية عند بدء التطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুছে ফেলা ডেটা সঙ্গে সঙ্গে ডেটাবেস থেকে সরানো হয়। রাখার মেয়াদ শেষ না হওয়া পর্যন্ত এখানে ব্যাকআপ পুনরুদ্ধার করতে পারেন। মেয়াদোত্তীর্ণ ব্যাকআপ অ্যাপ শুরু হলে পরিষ্কার করা হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazaná data se ihned odstraní z databáze. Jejich zálohu zde můžeš obnovit do konce doby uchování. Prošlé zálohy se vyčistí při spuštění aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slettede data fjernes straks fra databasen. Du kan gendanne sikkerhedskopien her, indtil opbevaringsperioden udløber. Udløbne sikkerhedskopier ryddes op, når appen starter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Daten werden sofort aus der Datenbank entfernt. Bis zum Ende der Frist kannst du ihre Sicherung hier wiederherstellen. Abgelaufene Sicherungen werden beim Appstart bereinigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted data is removed from the database immediately. You can restore its backup here until the retention period ends. Expired backups are cleaned up when the app starts."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted data is removed from the database immediately. You can restore its backup here until the retention period ends. Expired backups are cleaned up when the app starts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos eliminados se quitan inmediatamente de la base de datos. Puedes restaurar su copia aquí hasta que termine el plazo de conservación. Las copias caducadas se eliminan al iniciar la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données supprimées sont immédiatement retirées de la base de données. Tu peux restaurer leur sauvegarde ici jusqu’à la fin du délai de conservation. Les sauvegardes expirées sont effacées au démarrage de l’app."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données supprimées sont immédiatement retirées de la base de données. Tu peux restaurer leur sauvegarde ici jusqu’à la fin du délai de conservation. Les sauvegardes expirées sont effacées au démarrage de l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिटाया गया डेटा तुरंत डेटाबेस से हट जाता है। रखने की अवधि समाप्त होने तक उसका बैकअप यहाँ बहाल कर सकते हैं। अवधि पूरी कर चुके बैकअप ऐप शुरू होने पर साफ़ किए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati eliminati vengono rimossi subito dal database. Puoi ripristinarne il backup qui fino alla fine del periodo di conservazione. I backup scaduti vengono rimossi all’avvio dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除したデータはデータベースからすぐに取り除かれます。保持期間が終わるまでは、ここからバックアップを復元できます。期限切れのバックアップはアプリの起動時に削除されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderde gegevens worden direct uit de database verwijderd. Je kunt hun reservekopie hier herstellen tot de bewaartermijn afloopt. Verlopen reservekopieën worden bij het starten van de app opgeruimd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięte dane natychmiast znikają z bazy danych. Tutaj możesz przywrócić ich kopię do końca okresu przechowywania. Wygasłe kopie są usuwane przy uruchamianiu aplikacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados eliminados são removidos imediatamente da base de dados. Podes restaurar a sua cópia aqui até ao fim do período de retenção. As cópias expiradas são removidas quando a aplicação inicia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderade data tas bort från databasen direkt. Du kan återställa säkerhetskopian här tills lagringstiden löper ut. Utgångna säkerhetskopior rensas när appen startar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinen veriler veritabanından hemen kaldırılır. Saklama süresi bitene kadar yedeği buradan geri yükleyebilirsiniz. Süresi dolan yedekler uygulama başlatıldığında temizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалені дані відразу прибираються з бази даних. Їхню копію можна відновити тут до завершення строку зберігання. Прострочені копії очищаються при запуску застосунку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除的数据会立即从数据库移除。在保留期结束前，你可以在此恢复备份。过期备份会在应用启动时清理。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除的數據會立即從數據庫移除。在保留期結束前，你可以在此恢復備份。過期備份會在應用程式啓動時清理。"
          }
        }
      }
    },
