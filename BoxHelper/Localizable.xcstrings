    "BoxHelper unlocks powerful accessibility and lets you automate your inventory like never before." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنحك BoxHelper إمكانات وصول قوية ويتيح لك أتمتة مخزونك بطريقة غير مسبوقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper শক্তিশালী অ্যাক্সেসিবিলিটি সুবিধা দেয় এবং আপনার ইনভেন্টরি আগের চেয়ে বেশি স্বয়ংক্রিয় করতে সাহায্য করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper odemyká pokročilé funkce zpřístupnění a umožňuje vám automatizovat inventář jako nikdy předtím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper giver stærke tilgængelighedsfunktioner og lader dig automatisere dit inventar som aldrig før."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper bietet leistungsstarke Barrierefreiheit und ermöglicht eine nie dagewesene Automatisierung vom Inventar."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper unlocks powerful accessibility and lets you automate your inventory like never before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper desbloquea potentes funciones de accesibilidad y te permite automatizar tu inventario como nunca antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper offre une accessibilité puissante et vous permet d’automatiser votre inventaire comme jamais auparavant."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper offre une accessibilité puissante et vous permet d’automatiser votre inventaire comme jamais auparavant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बॉक्सहेल्पर शक्तिशाली अभिगम्यता सुविधाएँ प्रदान करता है और आपकी इन्वेंटरी को पहले से कहीं अधिक आसानी से स्वचालित करने देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper offre potenti funzioni di accessibilità e ti permette di automatizzare il tuo inventario come mai prima d’ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper は強力なアクセシビリティ機能を提供し、これまでにない形で在庫管理を自動化できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper biedt krachtige toegankelijkheidsfuncties en laat je je inventaris automatiseren als nooit tevoren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper oferuje rozbudowane funkcje dostępności i pozwala zautomatyzować inwentarz jak nigdy dotąd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaixaHelper unlocks powerful accessibility and lets you automate your inventory like never before."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper відкриває потужні можливості доступності та дозволяє автоматизувати ваш інвентар, як ніколи раніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
