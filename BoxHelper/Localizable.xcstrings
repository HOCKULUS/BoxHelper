      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إنهاء الوصول المشترك. سيتم الاحتفاظ بالبيانات المحلية التي تم تنزيلها بالفعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেয়ারড অ্যাক্সেস শেষ হবে। ইতিমধ্যে ডাউনলোড করা স্থানীয় ডেটা সংরক্ষণ করা হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílený přístup skončí. Již stažená místní data zůstanou zachována."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den fælles adgang afsluttes. Allerede hentede lokale data bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gemeinsame Zugriff endet. Bereits geladene lokale Daten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared access will end. Local data that has already been downloaded will be kept."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared access will end. Local data that has already been downloaded will be kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finalizará el acceso compartido. Se conservarán los datos locales ya descargados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès partagé prendra fin. Les données locales déjà téléchargées seront conservées."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès partagé prendra fin. Les données locales déjà téléchargées seront conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा पहुँच समाप्त हो जाएगी। पहले से डाउनलोड किया गया स्थानीय डेटा बना रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso condiviso terminerà. I dati locali già scaricati verranno conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有アクセスが終了します。ダウンロード済みのローカルデータは残ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gedeelde toegang wordt beëindigd. Reeds gedownloade lokale gegevens blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wspólny dostęp zakończy się. Pobrane już dane lokalne zostaną zachowane."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso partilhado terminará. Os dados locais já descarregados serão mantidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den delade åtkomsten avslutas. Redan hämtade lokala data behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşılan erişim sona erecek. İndirilmiş yerel veriler korunacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спільний доступ завершиться. Уже завантажені локальні дані залишаться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
