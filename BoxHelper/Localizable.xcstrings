    "Multiple Boxes found, consider disable ShortURL and print new labels for each box." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم العثور على عدة صناديق. فكّر في تعطيل ShortURL وطباعة ملصقات جديدة لكل صندوق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একাধিক বাক্স পাওয়া গেছে। ShortURL নিষ্ক্রিয় করে প্রতিটি বাক্সের জন্য নতুন লেবেল প্রিন্ট করার কথা বিবেচনা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bylo nalezeno více krabic, zvažte vypnutí ShortURL a vytisknutí nových štítků pro každou krabici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev fundet flere kasser. Overvej at deaktivere kort URL og udskrive nye etiketter til hver kasse."
