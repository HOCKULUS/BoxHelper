          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle tekst en geselecteerde afbeeldingen worden uit het opgeslagen concept verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
