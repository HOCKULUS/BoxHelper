    "Teile dein Inventar oder ausgewählte Standorte und Kisten. Unter „Inventar freigeben“ erstellst und verwaltest du deine Freigabe." : {
      "comment" : "Footer text for the InventorySharingSection.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك مخزونك أو المواقع والصناديق المحددة. أنشئ المشاركة وأدرها ضمن «مشاركة المخزون»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইনভেন্টরি বা নির্বাচিত অবস্থান ও বাক্স শেয়ার করুন। “ইনভেন্টরি শেয়ার করুন”-এ শেয়ার তৈরি ও পরিচালনা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílej inventář nebo vybraná umístění a krabice. Sdílení vytvoříš a spravuješ v části „Sdílet inventář“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del dit inventar eller valgte placeringer og kasser. Opret og administrer delingen under “Del inventar”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile dein Inventar oder ausgewählte Standorte und Kisten. Unter „Inventar freigeben“ erstellst und verwaltest du deine Freigabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your inventory or selected locations and boxes. Create and manage your share under “Share inventory”."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your inventory or selected locations and boxes. Create and manage your share under “Share inventory”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tu inventario o las ubicaciones y cajas seleccionadas. Crea y gestiona el recurso compartido en «Compartir inventario»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partage ton inventaire ou les emplacements et boîtes sélectionnés. Crée et gère ton partage dans « Partager l’inventaire »."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partage ton inventaire ou les emplacements et boîtes sélectionnés. Crée et gère ton partage dans « Partager l’inventaire »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी इन्वेंटरी या चुने हुए स्थान तथा डिब्बे साझा करें। “इन्वेंटरी साझा करें” में साझाकरण बनाएँ और उसका प्रबंधन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi il tuo inventario o le posizioni e scatole selezionate. Crea e gestisci la condivisione in “Condividi inventario”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インベントリ、または選択した場所と箱を共有できます。「インベントリを共有」で共有を作成・管理します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel je inventaris of geselecteerde locaties en dozen. Maak en beheer de gedeelde inventaris onder ‘Inventaris delen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnij inwentarz lub wybrane lokalizacje i pudełka. Utwórz udostępnienie i zarządzaj nim w „Udostępnij inwentarz”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partilha o teu inventário ou as localizações e caixas selecionadas. Cria e gere a partilha em «Partilhar inventário»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela ditt inventarium eller valda platser och lådor. Skapa och hantera delningen under ”Dela inventariet”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envanterinizi veya seçilen konum ve kutuları paylaşın. Paylaşımı “Envanteri paylaş” bölümünde oluşturup yönetin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поділися інвентарем або вибраними місцями й коробками. Створюй і керуй спільним доступом у розділі «Поділитися інвентарем»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享库存或所选的位置和箱子。在“共享库存”中创建和管理共享。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享庫存或所選的位置和箱子。在“共享庫存”中創建和管理共享。"
          }
        }
      }
    },
    "Teilen" : {
