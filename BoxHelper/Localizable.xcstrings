    "Export your data to share with others, restore a previous backup, or delete database and media." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدّر بياناتك لمشاركتها مع الآخرين، أو استعد نسخة احتياطية سابقة، أو احذف قاعدة البيانات والوسائط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ডেটা অন্যদের সাথে শেয়ার করতে এক্সপোর্ট করুন, আগের ব্যাকআপ পুনরুদ্ধার করুন, অথবা ডাটাবেস ও মিডিয়া মুছে ফেলুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportujte svá data pro sdílení s ostatními, obnovte předchozí zálohu nebo smažte databázi a média."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportér dine data for at dele dem med andre, gendan en tidligere backup, eller slet database og medier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere deine Daten, um sie zu teilen, ein Backup wiederherzustellen oder Datenbank und Medien zu löschen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export your data to share with others, restore a previous backup, or delete database and media."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta tus datos para compartirlos, restaurar una copia o borrar base de datos y medios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez vos données pour les partager avec d’autres, restaurer une sauvegarde précédente ou supprimer la base de données et les médias."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez vos données pour les partager avec d’autres, restaurer une sauvegarde précédente ou supprimer la base de données et les médias."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने डेटा को दूसरों के साथ साझा करने, पुराना बैकअप पुनर्स्थापित करने या डेटाबेस और मीडिया हटाने के लिए निर्यात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esportare i dati per condividerli con altri, ripristinare un backup precedente o eliminare database e supporti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データを書き出して共有したり、以前のバックアップを復元したり、データベースやメディアを削除したりできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteer je data om te delen, een back-up terug te zetten of alles te wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuj dane, aby udostępniać je innym, przywrócić poprzednią kopię zapasową albo usunąć bazę danych i media."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export your data to share with others, restore a previous cópia de segurança, or delete database and media."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортуйте свої дані, щоб поділитися ними з іншими, відновити попередню резервну копію або видалити базу даних і медіа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出你的资料以便与他人分享，还原先前的备份，或删除资料库和媒体文件。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯出你的資料以便與他人分享，還原先前的備份，或刪除資料庫和媒體檔案。"
          }
        }
      }
    },
