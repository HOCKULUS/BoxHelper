    "ListSorting.RememberDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتذكر معايير الفرز واتجاهه للصناديق والعناصر والمواقع والصور بعد إعادة تشغيل التطبيق. عند تعطيله، تبدأ كل جلسة جديدة بالفرز الافتراضي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ আবার চালু করার পর বাক্স, আইটেম, অবস্থান ও ছবির সাজানোর মানদণ্ড এবং দিক মনে রাখে। বন্ধ থাকলে প্রতিটি নতুন সেশন ডিফল্ট ক্রমে শুরু হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po restartu aplikace zachová kritéria a směr řazení krabic, položek, umístění a obrázků. Je-li vypnuto, každá nová relace začne výchozím řazením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk sorteringskriterier og retning for kasser, genstande, placeringer og billeder efter genstart af appen. Når dette er slået fra, begynder hver ny session med standardsorteringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortierkriterium und Reihenfolge für Kisten, Gegenstände, Standorte und Bilder nach einem App-Neustart beibehalten. Deaktiviert startet jede neue Sitzung mit der Standardsortierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember sorting criteria and direction for boxes, items, locations, and images after restarting the app. When disabled, each new session starts with the default sorting."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember sorting criteria and direction for boxes, items, locations, and images after restarting the app. When disabled, each new session starts with the default sorting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda los criterios y la dirección de ordenación de cajas, objetos, ubicaciones e imágenes al reiniciar la app. Si se desactiva, cada nueva sesión comienza con el orden predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémorise les critères et le sens du tri des boîtes, objets, emplacements et images après le redémarrage de l’app. Lorsque cette option est désactivée, chaque nouvelle session utilise le tri par défaut."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémorise les critères et le sens du tri des boîtes, objets, emplacements et images après le redémarrage de l’app. Lorsque cette option est désactivée, chaque nouvelle session utilise le tri par défaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप दोबारा शुरू करने के बाद डिब्बों, वस्तुओं, स्थानों और चित्रों के क्रम के मापदंड तथा दिशा याद रखता है। बंद होने पर हर नया सत्र डिफ़ॉल्ट क्रम से शुरू होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricorda criteri e direzione di ordinamento di scatole, oggetti, posizioni e immagini dopo il riavvio dell’app. Se disattivato, ogni nuova sessione inizia con l’ordinamento predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの再起動後も、箱、アイテム、場所、画像の並べ替え条件と順序を記憶します。無効にすると、新しいセッションは毎回初期の並び順から始まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onthoud sorteercriteria en richting voor dozen, items, locaties en afbeeldingen na het opnieuw starten van de app. Als dit is uitgeschakeld, begint elke nieuwe sessie met de standaardsortering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapamiętuje kryteria i kierunek sortowania pudełek, przedmiotów, lokalizacji i obrazów po ponownym uruchomieniu aplikacji. Po wyłączeniu każda nowa sesja zaczyna się od sortowania domyślnego."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoriza os critérios e o sentido de ordenação de caixas, itens, localizações e imagens depois de reiniciar a aplicação. Se desativado, cada nova sessão começa com a ordenação predefinida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom ihåg sorteringskriterier och riktning för lådor, föremål, platser och bilder efter omstart. Om detta stängs av börjar varje ny session med standardsorteringen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama yeniden başlatıldığında kutu, öğe, konum ve görsellerin sıralama ölçütlerini ve yönünü hatırlar. Kapatılırsa her yeni oturum varsayılan sıralamayla başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пам’ятати критерії та напрямок сортування коробок, предметів, місць і зображень після перезапуску застосунку. Коли вимкнено, кожен новий сеанс починається з типового сортування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重启应用后保留箱子、物品、位置和图片的排序条件及方向。关闭后，每次新会话都会使用默认排序。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重啓應用程式後保留箱子、物品、位置和圖片的排序條件及方向。關閉後，每次新會話都會使用預設排序。"
          }
        }
      }
    },
