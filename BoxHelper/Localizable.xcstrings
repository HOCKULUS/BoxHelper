    "No mail account is configured on this device. Please set up Mail first." : {
      "comment" : "A message displayed when the user tries to send feedback via mail but no mail account is configured on their device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم إعداد أي حساب بريد على هذا الجهاز. يرجى إعداد البريد أولاً."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
