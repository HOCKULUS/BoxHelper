        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La varita ajusta los umbrales dinámicamente durante la sesión. Las barras seleccionan niveles fijos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
