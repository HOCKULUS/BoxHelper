    "Selecting ‘new → old’ will use the most recent image as the preview for the box" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي اختيار «الأحدث ← الأقدم» إلى استخدام أحدث صورة كمعاينة للصندوق"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘নতুন → পুরোনো’ বেছে নিলে সবচেয়ে সাম্প্রতিক ছবিটি বাক্সের প্রিভিউ হিসেবে ব্যবহৃত হবে"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volba „nové → staré“ použije jako náhled krabice nejnovější obrázek"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vælger \"ny → gammel\", bruges det nyeste billede som forhåndsvisning for kassen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Auswahl von „neu → alt“ wird das neueste Bild als Vorschau verwendet"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecting ‘new → old’ will use the most recent image as the preview for the box"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccionar ‘nuevo → viejo’ usará la imagen más reciente como vista previa de la caja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection de « nouveau → ancien » utilisera l’image la plus récente comme aperçu de la boîte"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection de « nouveau → ancien » utilisera l’image la plus récente comme aperçu de la boîte"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘नया → पुराना’ चुनने पर डिब्बे के पूर्वावलोकन के लिए सबसे हाल की तस्वीर इस्तेमाल होगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con “nuovo → vecchio” si usa l’immagine più recente come anteprima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「新しい順 → 古い順」を選ぶと、最新の画像が箱のプレビューとして使用されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij ‘nieuw → oud’ wordt de nieuwste afbeelding als voorbeeld gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybranie „nowe → stare” spowoduje użycie najnowszego obrazu jako podglądu pudełka."
          }
        },
        "pt-PT" : {
