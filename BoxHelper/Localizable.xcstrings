        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আইটেমের বাক্সের মাধ্যমে অবস্থানের ID ফেরত দেয়, বা অবস্থান নির্ধারিত না থাকলে কোনো মান ফেরত দেয় না।"
