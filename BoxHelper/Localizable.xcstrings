          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le texte et les images sélectionnées seront supprimés du brouillon enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
