            "value" : "تُحذف فورًا النسخ الاحتياطية الأقدم من الحد الجديد. يؤدي إيقاف الاحتفاظ إلى إفراغ سلة المهملات وتعطيل النسخ الاحتياطي لعمليات الحذف المستقبلية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন সীমার চেয়ে পুরোনো ব্যাকআপ সঙ্গে সঙ্গে মোছা হয়। রাখা বন্ধ করলে ট্র্যাশ খালি হয় এবং ভবিষ্যতে মুছে ফেলা ডেটার ব্যাকআপ বন্ধ হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zálohy starší než nový limit se ihned smažou. Vypnutí uchovávání vyprázdní koš a vypne zálohování budoucích smazání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopier, der er ældre end den nye grænse, slettes straks. Deaktivering tømmer papirkurven og slår sikkerhedskopiering af fremtidige sletninger fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherungen, die älter als die neue Frist sind, werden sofort gelöscht. Ausschalten leert den Papierkorb und deaktiviert die Sicherung künftiger Löschungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups older than the new limit are deleted immediately. Turning retention off empties the trash and disables backups for future deletions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups older than the new limit are deleted immediately. Turning retention off empties the trash and disables backups for future deletions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias más antiguas que el nuevo límite se eliminan inmediatamente. Desactivar la conservación vacía la papelera y desactiva las copias de futuras eliminaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes plus anciennes que la nouvelle limite sont immédiatement supprimées. La désactivation vide la corbeille et désactive les sauvegardes des suppressions futures."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes plus anciennes que la nouvelle limite sont immédiatement supprimées. La désactivation vide la corbeille et désactive les sauvegardes des suppressions futures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई सीमा से पुराने बैकअप तुरंत मिटा दिए जाते हैं। रखने की सुविधा बंद करने से ट्रैश खाली हो जाता है और भविष्य में मिटाए जाने वाले डेटा का बैकअप बंद हो जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup più vecchi del nuovo limite vengono eliminati subito. Disattivare la conservazione svuota il cestino e disattiva i backup delle eliminazioni future."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい期限より古いバックアップはすぐに削除されます。保持をオフにするとゴミ箱が空になり、今後の削除時のバックアップも無効になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservekopieën die ouder zijn dan de nieuwe limiet worden direct verwijderd. Uitschakelen leegt de prullenmand en schakelt reservekopieën voor toekomstige verwijderingen uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie starsze niż nowy limit są natychmiast usuwane. Wyłączenie przechowywania opróżnia kosz i wyłącza kopie przyszłych usunięć."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias mais antigas do que o novo limite são eliminadas imediatamente. Desativar a retenção esvazia o lixo e desativa as cópias de futuras eliminações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopior äldre än den nya gränsen raderas direkt. Avstängning tömmer papperskorgen och inaktiverar säkerhetskopiering för framtida raderingar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni sınırdan eski yedekler hemen silinir. Saklamayı kapatmak çöp kutusunu boşaltır ve gelecekteki silmeler için yedeklemeyi devre dışı bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копії, старші за новий строк, видаляються відразу. Вимкнення зберігання очищає кошик і вимикає резервування майбутніх видалень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早于新期限的备份会立即删除。关闭保留功能会清空回收站，并停用今后删除操作的备份。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早於新期限的備份會立即刪除。關閉保留功能會清空垃圾桶，並停用今後刪除操作的備份。"
          }
        }
      }
    },
