    "Launch5.Shortcuts.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للاختصارات الآن فعل المزيد. اكتشف إجراءات جديدة لسير عملك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শর্টকাট এখন আরও বেশি কাজ করতে পারে। আপনার ওয়ার্কফ্লোর জন্য নতুন কাজ আবিষ্কার করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkratky nyní zvládnou ještě více. Objev nové akce pro své pracovní postupy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genveje kan nu endnu mere. Opdag nye handlinger til dine arbejdsgange."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kurzbefehle können jetzt noch mehr. Entdecke die neuen Funktionen für deine Abläufe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts can now do even more. Discover new actions for your workflows."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts can now do even more. Discover new actions for your workflows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los atajos ahora pueden hacer aún más. Descubre nuevas acciones para tus flujos de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis offrent maintenant encore plus de possibilités. Découvre de nouvelles actions pour tes processus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis offrent maintenant encore plus de possibilités. Découvre de nouvelles actions pour tes processus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शॉर्टकट अब और भी काम कर सकते हैं। अपने वर्कफ़्लो के लिए नई कार्रवाइयाँ खोजें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I comandi rapidi ora possono fare ancora di più. Scopri nuove azioni per i tuoi flussi di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットでできることが増えました。ワークフローに使える新しいアクションを見つけましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdrachten kunnen nu nog meer. Ontdek nieuwe acties voor je workflows."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skróty potrafią teraz jeszcze więcej. Odkryj nowe działania dla swoich procesów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Atalhos podem agora fazer ainda mais. Descobre novas ações para os teus fluxos de trabalho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genvägar kan nu göra mer. Upptäck nya åtgärder för dina arbetsflöden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kestirmeler artık daha fazlasını yapabilir. İş akışlarınız için yeni işlemler keşfedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкі команди тепер можуть ще більше. Відкрий нові дії для своїх робочих процесів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷指令现在能做更多。探索适用于工作流程的新操作。"
          }
        },
