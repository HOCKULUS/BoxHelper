    },
    "This app works best with iOS 18 or newer. Some features might not function correctly on your version." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل هذا التطبيق بشكل أفضل مع iOS 18 أو الأحدث. قد لا تعمل بعض الميزات بشكل صحيح على إصدارك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অ্যাপটি iOS 18 বা তার পরের সংস্করণে সবচেয়ে ভালো কাজ করে। আপনার সংস্করণে কিছু ফিচার সঠিকভাবে কাজ নাও করতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato aplikace funguje nejlépe na iOS 18 nebo novějším. Některé funkce na vaší verzi nemusí fungovat správně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne app fungerer bedst med iOS 18 eller nyere. Nogle funktioner fungerer muligvis ikke korrekt på din version."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
