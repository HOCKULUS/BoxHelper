    "Damit ich weiß, ob sich der Aufwand, die laufenden Kosten und meine Zeit lohnen, bin ich auf dein Feedback angewiesen." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyvíjím BoxHelper bez sledování v aplikaci, reklamy nebo externího financování."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit ich weiß, ob sich der Aufwand, die laufenden Kosten und meine Zeit lohnen, bin ich auf dein Feedback angewiesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollo BoxHelper sin seguimiento dentro de la app, sin publicidad y sin financiación externa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour savoir si l’effort, les coûts permanents et mon temps en valent la peine, j’ai besoin de vos retours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per capire se l’impegno, i costi continui e il mio tempo valgono davvero la pena, ho bisogno del tuo feedback."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om te weten of de inspanning, de doorlopende kosten en mijn tijd de moeite waard zijn, ben ik afhankelijk van jouw feedback."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了让我知道这些投入、持续成本和时间是否值得，我非常依赖你的反馈。"
          }
        }
      },
      "shouldTranslate" : false
    },
