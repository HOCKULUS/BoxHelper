    "FeedMonitoring.BasicDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعديل السحر للعُتبات ديناميكياً أثناء الجلسة. الأشرطة تختار مستويات ثابتة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "জাদুর কাঠি সেশন চলাকালে সীমাগুলো গতিশীলভাবে বদলায়। বার দিয়ে নির্দিষ্ট স্তর বেছে নেওয়া যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kouzelná hůlka během relace dynamicky upravuje prahy. Proužky vybírají pevné úrovně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryllestaven tilpasser tærskler dynamisk under sessionen. Bjælkerne vælger faste niveauer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Zauberstab werden Schwellen während der Sitzung dynamisch angepasst. Die Balken wählen feste Stufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wand dynamically adjusts thresholds during the session. Bars select fixed levels."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wand dynamically adjusts thresholds during the session. Bars select fixed levels."
