    "FeedMonitoring.TimeoutMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم اكتشاف أي تغييرات خلال فترة عدم النشاط المحددة. تم إيقاف الالتقاط التلقائي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্ধারিত নিষ্ক্রিয় সময়ে কোনো পরিবর্তন শনাক্ত হয়নি। স্বয়ংক্রিয় ছবি তোলা বন্ধ করা হয়েছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během nastavené doby nečinnosti nebyly zjištěny změny. Automatické snímání bylo vypnuto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev ikke registreret ændringer i den indstillede periode uden aktivitet. Automatisk optagelse er slået fra."
