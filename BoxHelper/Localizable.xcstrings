    "Creates a new item and assigns it to a box. Returns the new item's ID" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ عنصراً جديداً ويعينه إلى صندوق. يعيد معرف العنصر الجديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি নতুন আইটেম তৈরি করে সেটিকে একটি বাক্সে যুক্ত করে। নতুন আইটেমের ID ফেরত দেয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoří novou položku a přiřadí ji ke krabici. Vrátí ID nové položky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opretter en ny genstand og knytter den til en kasse. Returnerer den nye genstands ID."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt ein neuen Gegenstand und weist es einer Kiste zu. Gibt die ID des neuen Gegenstandes zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a new item and assigns it to a box. Returns the new item's ID"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a new item and assigns it to a box. Returns the new item's ID"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un nuevo objeto y lo asigna a una caja. Devuelve el ID del nuevo objeto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un nouvel élément et l’assigne à une boîte. Renvoie l’ID du nouvel élément"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un nouvel élément et l’assigne à une boîte. Renvoie l’ID du nouvel élément"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई वस्तु बनाता है और उसे किसी डिब्बे को सौंपता है। नई वस्तु की ID लौटाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un nuovo elemento e lo assegna a una scatola. Restituisce l’ID del nuovo elemento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいアイテムを作成して箱に割り当てます。新しいアイテムのIDを返します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt een nieuw item aan en wijst het toe aan een doos. Geeft de ID van het nieuwe item terug"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy nowy przedmiot i przypisuje go do pudełka. Zwraca identyfikator nowego przedmiotu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a new item and assigns it to a caixa. Returns the new item's ID"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapar ett nytt föremål och tilldelar det en låda. Returnerar det nya föremålets ID."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir öğe oluşturup bir kutuya atar. Yeni öğenin ID’sini döndürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створює новий елемент і призначає його коробці. Повертає ID нового елемента"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立新物品並将其指派給箱子，然后回传新物品的 ID。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立新物品並將其指派給箱子，然後回傳新物品的 ID。"
          }
        }
      }
    },
    "Creates a ZIP backup of app data and returns the ZIP file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
