    "Enabling this allows navigation into deeper subviews, which could potentially be confusing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح تفعيل هذا التنقل إلى عروض فرعية أعمق، مما قد يكون مربكاً أحياناً."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি সক্রিয় করলে আরও গভীর সাবভিউতে নেভিগেশন করা যাবে, যা কিছুটা বিভ্রান্তিকর হতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zapnutí bude možné přecházet do hlubších podzobrazení, což může být potenciálně matoucí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktiveret, kan du navigere ind i dybere undervisninger, hvilket potentielt kan være forvirrende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch aktivieren dieser Option, kann in tiefere Unteransichten navigiert werden, was unter Umständen verwirrend sein kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabling this allows navigation into deeper subviews, which could potentially be confusing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabling this allows navigation into deeper subviews, which could potentially be confusing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activarlo, se permite navegar a subniveles más profundos, lo que podría resultar confuso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activation de cette option permet de naviguer dans des sous-vues plus profondes, ce qui peut être déroutant."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activation de cette option permet de naviguer dans des sous-vues plus profondes, ce qui peut être déroutant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे सक्षम करने पर गहरे उपदृश्यों में नेविगेशन संभव होगा, जो थोड़ा भ्रमित कर सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attivazione di questa opzione consente di navigare in sottoviste più profonde, il che potrebbe risultare confuso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを有効にすると、より深いサブビューへ移動できるようになりますが、操作が分かりにくくなる可能性があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, kun je naar diepere subweergaven navigeren, wat mogelijk verwarrend kan zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączenie tej opcji umożliwia przechodzenie do głębszych podwidoków, co może być potencjalnie mylące."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
