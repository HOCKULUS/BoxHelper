    "Import boxes, items, locations, and photos from a BoxHelper ZIP backup. By default, merge by ID and keep newer objects. Optionally replace the current inventory." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستورد الصناديق والعناصر والمواقع والصور من نسخة ZIP احتياطية لـ BoxHelper. يدمج البيانات حسب المعرّف ويحتفظ بالكائنات الأحدث افتراضيًا. يمكن أيضًا استبدال المخزون الحالي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper ZIP ব্যাকআপ থেকে বাক্স, আইটেম, অবস্থান ও ছবি আমদানি করে। ডিফল্টভাবে ID অনুযায়ী ডেটা মিলিয়ে নতুন অবজেক্ট রাখে। চাইলে বর্তমান ইনভেন্টরি প্রতিস্থাপন করা যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importuje krabice, položky, umístění a fotografie ze zálohy ZIP BoxHelperu. Ve výchozím nastavení sloučí data podle ID a zachová novější objekty. Volitelně nahradí aktuální inventář."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importerer kasser, genstande, placeringer og fotos fra en BoxHelper-ZIP-sikkerhedskopi. Som standard flettes efter ID, og nyere objekter bevares. Kan også erstatte det aktuelle inventar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere Kisten, Gegenstände, Standorte und Fotos aus einem BoxHelper-ZIP-Backup. Standardmäßig werden die Daten anhand ihrer IDs zusammengeführt und neuere Objekte behalten. Optional kann der aktuelle Bestand ersetzt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import boxes, items, locations, and photos from a BoxHelper ZIP backup. By default, merge by ID and keep newer objects. Optionally replace the current inventory."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import boxes, items, locations, and photos from a BoxHelper ZIP backup. By default, merge by ID and keep newer objects. Optionally replace the current inventory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa cajas, objetos, ubicaciones y fotos de una copia ZIP de BoxHelper. De forma predeterminada, combina los datos por identificador y conserva los objetos más recientes. También puede sustituir el inventario actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe des boîtes, objets, emplacements et photos depuis une sauvegarde ZIP BoxHelper. Par défaut, fusionne les données par identifiant et conserve les objets les plus récents. Peut aussi remplacer l’inventaire actuel."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe des boîtes, objets, emplacements et photos depuis une sauvegarde ZIP BoxHelper. Par défaut, fusionne les données par identifiant et conserve les objets les plus récents. Peut aussi remplacer l’inventaire actuel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper ZIP बैकअप से डिब्बे, वस्तुएँ, स्थान और फ़ोटो आयात करता है। डिफ़ॉल्ट रूप से ID के आधार पर डेटा मिलाता है और नए ऑब्जेक्ट रखता है। चाहें तो वर्तमान इन्वेंटरी को बदल सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa scatole, oggetti, posizioni e foto da un backup ZIP di BoxHelper. Per impostazione predefinita, unisce i dati per ID e conserva gli oggetti più recenti. Può anche sostituire l’inventario attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper の ZIP バックアップから箱、アイテム、場所、写真を読み込みます。通常は ID で統合して新しいオブジェクトを保持します。現在のインベントリを置き換えることもできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importeert dozen, items, locaties en foto’s uit een BoxHelper-ZIP-reservekopie. Standaard worden gegevens op ID samengevoegd en blijven de nieuwste objecten behouden. Kan ook de huidige inventaris vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importuje pudełka, przedmioty, lokalizacje i zdjęcia z kopii ZIP BoxHelper. Domyślnie scala dane według ID i zachowuje nowsze obiekty. Opcjonalnie zastępuje bieżący inwentarz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa caixas, itens, localizações e fotografias de uma cópia de segurança ZIP do BoxHelper. Por predefinição, combina os dados por ID e mantém os objetos mais recentes. Pode também substituir o inventário atual."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importerar lådor, föremål, platser och foton från en ZIP-säkerhetskopia av BoxHelper. Som standard slås data ihop efter ID och nyare objekt behålls. Det går även att ersätta det aktuella inventariet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper ZIP yedeğinden kutuları, öğeleri, konumları ve fotoğrafları içe aktarır. Varsayılan olarak ID’ye göre birleştirip yeni nesneleri korur. İstenirse mevcut envanter değiştirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортує коробки, предмети, місця й фото з ZIP-копії BoxHelper. Типово об’єднує дані за ID і зберігає новіші об’єкти. Також може замінити поточний інвентар."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 BoxHelper ZIP 备份导入箱子、物品、位置和照片。默认按 ID 合并并保留较新的对象。也可选择替换当前库存。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 BoxHelper ZIP 備份匯入箱子、物品、位置和照片。預設按 ID 合併並保留較新的對象。也可選擇替換當前庫存。"
          }
        }
      }
    },
