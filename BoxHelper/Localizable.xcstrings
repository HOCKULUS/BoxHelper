    "Die Löschung konnte nicht vollständig abgeschlossen werden. Ein Teil der Daten kann bereits gelöscht sein. Bitte versuche es erneut." : {
      "comment" : "A message displayed when the iCloud deletion fails.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم إكمال الحذف بالكامل. قد تكون بعض البيانات قد تم حذفها بالفعل. يرجى المحاولة مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিলিট সম্পূর্ণভাবে শেষ হয়নি। কিছু ডেটা ইতিমধ্যে মুছে ফেলা হতে পারে। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazání se nepodařilo zcela dokončit. Některá data již mohou být smazána. Zkus to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletningen kunne ikke fuldføres. Nogle data kan allerede være slettet. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Löschung konnte nicht vollständig abgeschlossen werden. Ein Teil der Daten kann bereits gelöscht sein. Bitte versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion could not be fully completed. Some data may already have been deleted. Please try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion could not be fully completed. Some data may already have been deleted. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
