    "Launch5.QRCode.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض رمز QR لـ BoxHelper على الوضع التلقائي لاختيار الصندوق المطابق مسبقًا. لا حاجة للبحث اليدوي بعد الآن!"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় মোডকে BoxHelper QR কোড দেখিয়ে মিল থাকা বাক্স আগে থেকেই বেছে নিন। আর হাতে খুঁজতে হবে না!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukaž automatickému režimu QR kód BoxHelperu a předem vyber odpovídající krabici. Už žádné ruční hledání!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis automatisk tilstand en BoxHelper-QR-kode for at vælge den tilsvarende kasse på forhånd. Slut med manuel søgning!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig der Automatik einen BoxHelper-QR-Code, und die passende Kiste wird vorausgewählt. Kein manuelles Suchen mehr!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show automatic mode a BoxHelper QR code to preselect the matching box. No more manual searching!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show automatic mode a BoxHelper QR code to preselect the matching box. No more manual searching!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un código QR de BoxHelper al modo automático para preseleccionar la caja correspondiente. ¡Se acabó buscarla manualmente!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Présente un code QR BoxHelper au mode automatique pour présélectionner la boîte correspondante. Plus besoin de la chercher manuellement !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Présente un code QR BoxHelper au mode automatique pour présélectionner la boîte correspondante. Plus besoin de la chercher manuellement !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलते-जुलते डिब्बे को पहले से चुनने के लिए स्वचालित मोड को BoxHelper QR कोड दिखाएँ। अब हाथ से खोजना नहीं पड़ेगा!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un codice QR BoxHelper alla modalità automatica per preselezionare la scatola corrispondente. Basta ricerche manuali!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動モードに BoxHelper の QR コードを見せると、対応する箱を事前に選択できます。手動で探す必要はありません！"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de automatische modus een BoxHelper-QR-code zien om de bijbehorende doos vooraf te selecteren. Geen handmatig zoeken meer!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż trybowi automatycznemu kod QR BoxHelper, aby wstępnie wybrać pasujące pudełko. Koniec z ręcznym szukaniem!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra um código QR do BoxHelper ao modo automático para selecionar previamente a caixa correspondente. Deixa de ser preciso procurá-la manualmente!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa automatiskt läge en BoxHelper-QR-kod för att välja rätt låda i förväg. Ingen manuell sökning behövs!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlgili kutuyu önceden seçmek için otomatik moda bir BoxHelper QR kodu gösterin. Artık elle aramak yok!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажи автоматичному режиму QR-код BoxHelper, щоб заздалегідь вибрати потрібну коробку. Більше не треба шукати вручну!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向自动模式展示 BoxHelper QR 码，即可预先选择相应箱子。无需再手动搜索！"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向自動模式展示 BoxHelper QR 碼，即可預先選擇相應箱子。無需再手動搜索！"
          }
        }
      }
    },
