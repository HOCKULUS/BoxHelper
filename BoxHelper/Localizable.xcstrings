    "FeedMonitoring.IntroMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت الكاميرا واجعل الخلفية فارغة. بعد المعايرة، ضع عنصراً في مجال الرؤية وأبعد يديك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্যামেরা স্থির করুন এবং পটভূমি খালি রাখুন। ক্যালিব্রেশনের পর আইটেমটি দৃশ্যে রাখুন এবং হাত সরিয়ে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upevni kameru a nech pozadí prázdné. Po kalibraci vlož položku do záběru a odtáhni ruce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fastgør kameraet og hold baggrunden tom. Læg en genstand i billedet efter kalibrering, og fjern hænderne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera fest aufstellen und den Hintergrund leer halten. Nach der Referenzaufnahme einen Gegenstand ins Bild legen und die Hände wegnehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the camera fixed and the background empty. After calibration, place an item in view and remove your hands."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the camera fixed and the background empty. After calibration, place an item in view and remove your hands."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija la cámara y deja el fondo vacío. Tras la calibración, coloca un objeto en el encuadre y retira las manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe la caméra et laisse l’arrière-plan vide. Après l’étalonnage, place un objet dans le champ et retire tes mains."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe la caméra et laisse l’arrière-plan vide. Après l’étalonnage, place un objet dans le champ et retire tes mains."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा स्थिर रखें और पृष्ठभूमि खाली रखें। अंशांकन के बाद वस्तु को दृश्य में रखें और हाथ हटा लें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa la fotocamera e lascia vuoto lo sfondo. Dopo la calibrazione, metti un oggetto nell’inquadratura e togli le mani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラを固定し、背景を空にしてください。調整後、アイテムを画面に置いて手を離してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de camera vast en houd de achtergrond leeg. Leg na de kalibratie een item in beeld en haal je handen weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw aparat nieruchomo i pozostaw puste tło. Po kalibracji umieść przedmiot w kadrze i zabierz ręce."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa a câmara e deixa o fundo vazio. Após a calibração, coloca um item no enquadramento e retira as mãos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fäst kameran och håll bakgrunden tom. Lägg ett föremål i bild efter kalibreringen och ta bort händerna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerayı sabitleyin ve arka planı boş tutun. Kalibrasyondan sonra öğeyi görüntüye koyup ellerinizi çekin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зафіксуй камеру й залиш тло порожнім. Після калібрування поклади предмет у кадр і прибери руки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定相机并保持背景为空。校准后，将物品放入画面并移开双手。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定相機並保持背景為空。校准後，將物品放入畫面並移開雙手。"
          }
        }
      }
    },
