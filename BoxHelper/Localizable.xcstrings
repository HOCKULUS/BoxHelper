    "Launch5.Automatic.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع الكاميرا فوق الصندوق أو أمام خلفية فارغة وابدأ التعبئة. يلتقط الوضع التلقائي الصور كلما تغير شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্যামেরা বাক্সের ওপরে বা খালি পটভূমির সামনে রাখুন এবং প্যাক করা শুরু করুন। স্বয়ংক্রিয় মোড কিছু বদলালেই ছবি তোলে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umísti kameru nad krabici nebo před prázdné pozadí a začni balit. Automatický režim pořizuje fotografie při každé změně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer kameraet over kassen eller foran en tom baggrund, og begynd at pakke. Automatisk tilstand tager fotos, når noget ændrer sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positioniere die Kamera über der Kiste oder vor einem klaren Hintergrund und pack los. Die Automatik fotografiert Änderungen von selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position the camera above your box or in front of a clear background and start packing. Automatic mode takes photos whenever things change."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position the camera above your box or in front of a clear background and start packing. Automatic mode takes photos whenever things change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca la cámara sobre tu caja o delante de un fondo despejado y empieza a empaquetar. El modo automático hace fotos cada vez que algo cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place la caméra au-dessus de ta boîte ou devant un arrière-plan dégagé et commence à emballer. Le mode automatique prend des photos dès qu’un changement se produit."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place la caméra au-dessus de ta boîte ou devant un arrière-plan dégagé et commence à emballer. Le mode automatique prend des photos dès qu’un changement se produit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा अपने डिब्बे के ऊपर या साफ़ पृष्ठभूमि के सामने रखें और पैक करना शुरू करें। स्वचालित मोड हर बदलाव पर फ़ोटो लेता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiziona la fotocamera sopra la scatola o davanti a uno sfondo libero e inizia a imballare. La modalità automatica scatta foto ogni volta che qualcosa cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラを箱の上または何もない背景の前に設置して、荷造りを始めましょう。自動モードでは変化があるたびに写真を撮影します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaats de camera boven je doos of voor een lege achtergrond en begin met inpakken. De automatische modus maakt foto’s zodra er iets verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieść aparat nad pudełkiem lub przed pustym tłem i zacznij pakować. Tryb automatyczny robi zdjęcia, gdy coś się zmienia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca a câmara por cima da caixa ou à frente de um fundo desimpedido e começa a embalar. O modo automático tira fotografias sempre que algo muda."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placera kameran ovanför lådan eller framför en tom bakgrund och börja packa. Automatiskt läge tar foton när något ändras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerayı kutunuzun üzerine veya boş bir arka planın önüne yerleştirip paketlemeye başlayın. Otomatik mod bir şey değiştiğinde fotoğraf çeker."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмісти камеру над коробкою або перед порожнім тлом і починай пакувати. Автоматичний режим робить фото щоразу, коли щось змінюється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将相机放在箱子上方或空白背景前，然后开始打包。自动模式会在出现变化时拍照。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將相機放在箱子上方或空白背景前，然後開始打包。自動模式會在出現變化時拍照。"
          }
        }
      }
    },
