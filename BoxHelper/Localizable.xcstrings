    "There was a problem processing the link you opened. Please check if the link is correct and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدثت مشكلة أثناء معالجة الرابط الذي فتحته. يرجى التحقق من صحة الرابط والمحاولة مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যে লিঙ্কটি খুলেছেন তা প্রক্রিয়াকরণে একটি সমস্যা হয়েছে। অনুগ্রহ করে লিঙ্কটি সঠিক কিনা যাচাই করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zpracování otevřeného odkazu došlo k problému. Zkontrolujte prosím, zda je odkaz správný, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der opstod et problem under behandlingen af det link, du åbnede. Kontroller, at linket er korrekt, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Verarbeiten des geöffneten Links gab es ein Problem. Bitte überprüfe den Link und versuche es erneut."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There was a problem processing the link you opened. Please check if the link is correct and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubo un problema al procesar el enlace que abriste. Comprueba si el enlace es correcto e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un problème est survenu lors du traitement du lien que vous avez ouvert. Veuillez vérifier que le lien est correct et réessayer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un problème est survenu lors du traitement du lien que vous avez ouvert. Veuillez vérifier que le lien est correct et réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने जो लिंक खोला उसे संसाधित करने में समस्या हुई। कृपया जाँचें कि लिंक सही है और फिर से प्रयास करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’è stato un problema con il link. Controlla che sia corretto e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いたリンクの処理中に問題が発生しました。リンクが正しいか確認して、もう一度お試しください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er was een probleem met het verwerken van de link. Controleer of de link klopt en probeer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystąpił problem podczas przetwarzania otwartego linku. Sprawdź, czy link jest poprawny, i spróbuj ponownie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There was a problem processing the link you opened. Please check if the link is correct and try again."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час обробки відкритого вами посилання виникла проблема. Будь ласка, перевірте, чи правильне посилання, і спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處理你打开的链接时发生问题。请检查链接是否正確，然后再试一次。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
