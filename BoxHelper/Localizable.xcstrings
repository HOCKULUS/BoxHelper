    "Bearbeiten enthält Bilder. Ohne Bilder werden weder Fotos noch Bildverweise geteilt." : {
      "comment" : "A description of the rights of the user to edit the shared inventory.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل الوصول للتعديل الصور. بدون الصور، لا تتم مشاركة الصور ولا المراجع إلى الصور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পাদনা অ্যাক্সেসে ছবি অন্তর্ভুক্ত থাকে। ছবি না থাকলে, কোনো ফটো বা ইমেজ রেফারেন্স শেয়ার করা হবে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup pro úpravy zahrnuje obrázky. Bez obrázků se nesdílejí fotografie ani odkazy na obrázky."
