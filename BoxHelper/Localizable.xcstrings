    "Tags are automatically generated from text detected in images to improve search results." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنشأ العلامات تلقائياً من النص المكتشف في الصور لتحسين نتائج البحث."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুসন্ধানের ফল আরও ভালো করতে ছবিতে শনাক্ত করা টেক্সট থেকে স্বয়ংক্রিয়ভাবে ট্যাগ তৈরি হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Značky se automaticky generují z textu rozpoznaného na obrázcích pro lepší výsledky vyhledávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags oprettes automatisk ud fra tekst, der registreres i billeder, for at forbedre søgeresultaterne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags werden automatisch aus erkannten Texten in Bildern erzeugt, um die Suchergebnisse zu verbessern."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags are automatically generated from text detected in images to improve search results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las etiquetas se generan automáticamente a partir del texto detectado en las imágenes para mejorar los resultados de búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étiquettes sont générées automatiquement à partir du texte détecté dans les images afin d’améliorer les résultats de recherche."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étiquettes sont générées automatiquement à partir du texte détecté dans les images afin d’améliorer les résultats de recherche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोज परिणाम बेहतर करने के लिए टैग चित्रों में पहचाने गए पाठ से अपने-आप बनाए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tag vengono generati automaticamente dal testo rilevato nelle immagini per migliorare la ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索結果を改善するため、画像内で検出した文字からタグを自動生成します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags worden automatisch gegenereerd uit tekst in afbeeldingen om zoekresultaten te verbeteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagi są automatycznie generowane z tekstu wykrytego na obrazach, aby poprawić wyniki wyszukiwania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags are automatically generated from text detected in imagems to improve search results."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мітки автоматично генеруються з тексту, знайденого на зображеннях, щоб покращити результати пошуку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签会根据图片中偵测到的文字自动产生，以提升搜索结果。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤會根據圖片中偵測到的文字自動產生，以提升搜尋結果。"
          }
        }
      }
