    "Trash.TipMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ البيانات المحذوفة لمدة 30 يومًا، بما في ذلك عمليات الحذف عبر iCloud. افتح التخزين والنسخ الاحتياطي → سلة المهملات لاستعادتها أو تقليل المدة أو تعطيل الاحتفاظ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুছে ফেলা ডেটার ব্যাকআপ ৩০ দিন রাখা হয়, iCloud-এর মোছাও এর মধ্যে আছে। পুনরুদ্ধার করতে, মেয়াদ কমাতে বা রাখা বন্ধ করতে স্টোরেজ ও ব্যাকআপ → ট্র্যাশ খুলুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazaná data se zálohují po dobu 30 dní, včetně smazání přes iCloud. Otevři Úložiště a záloha → Koš, kde je obnovíš, zkrátíš dobu nebo vypneš uchovávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slettede data sikkerhedskopieres i 30 dage, også ved iCloud-sletninger. Åbn Lagring og sikkerhedskopi → Papirkurv for at gendanne dem, forkorte perioden eller slå opbevaring fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Daten werden 30 Tage gesichert, auch bei iCloud-Löschungen. Unter Speicher & Sicherung → Papierkorb kannst du sie wiederherstellen und die Frist verkürzen oder ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted data is backed up for 30 days, including iCloud deletions. Open Storage & Backup → Trash to restore it or shorten or turn off retention."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted data is backed up for 30 days, including iCloud deletions. Open Storage & Backup → Trash to restore it or shorten or turn off retention."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos eliminados se guardan durante 30 días, incluidas las eliminaciones de iCloud. Abre Almacenamiento y copia de seguridad → Papelera para restaurarlos, acortar el plazo o desactivar la conservación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données supprimées sont sauvegardées pendant 30 jours, même après une suppression iCloud. Ouvre Stockage et sauvegarde → Corbeille pour les restaurer, réduire le délai ou désactiver la conservation."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données supprimées sont sauvegardées pendant 30 jours, même après une suppression iCloud. Ouvre Stockage et sauvegarde → Corbeille pour les restaurer, réduire le délai ou désactiver la conservation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिटाए गए डेटा का बैकअप 30 दिन रखा जाता है, इसमें iCloud से मिटाया गया डेटा भी शामिल है। उसे बहाल करने, अवधि घटाने या रखना बंद करने के लिए स्टोरेज और बैकअप → ट्रैश खोलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati eliminati vengono salvati per 30 giorni, comprese le eliminazioni da iCloud. Apri Archiviazione e backup → Cestino per ripristinarli, ridurre il periodo o disattivare la conservazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud での削除も含め、削除したデータを30日間バックアップします。「ストレージとバックアップ → ゴミ箱」から復元、保持期間の短縮、保持の無効化ができます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderde gegevens worden 30 dagen bewaard, ook bij iCloud-verwijderingen. Open Opslag en reservekopieën → Prullenmand om ze te herstellen, de termijn te verkorten of het bewaren uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięte dane są przechowywane przez 30 dni, także przy usunięciach z iCloud. Otwórz Pamięć i kopie zapasowe → Kosz, aby je przywrócić, skrócić okres lub wyłączyć przechowywanie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados eliminados são guardados durante 30 dias, incluindo as eliminações do iCloud. Abre Armazenamento e cópias de segurança → Lixo para os restaurar, reduzir o prazo ou desativar a retenção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderade data säkerhetskopieras i 30 dagar, även vid iCloud-radering. Öppna Lagring och säkerhetskopiering → Papperskorg för att återställa, förkorta tiden eller stänga av lagring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinen veriler, iCloud silmeleri dâhil, 30 gün yedeklenir. Geri yüklemek, süreyi kısaltmak veya saklamayı kapatmak için Depolama ve Yedekleme → Çöp Kutusu’nu açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалені дані зберігаються 30 днів, включно з видаленнями через iCloud. Відкрий Сховище й резервні копії → Кошик, щоб відновити їх, скоротити строк або вимкнути зберігання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除数据会备份 30 天，包括通过 iCloud 删除的数据。打开“存储与备份 → 回收站”，可恢复数据、缩短保留期或关闭保留功能。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已刪除數據會備份 30 天，包括通過 iCloud 刪除的數據。打開“存儲與備份 → 垃圾桶”，可恢複數據、縮短保留期或關閉保留功能。"
          }
        }
      }
    },
