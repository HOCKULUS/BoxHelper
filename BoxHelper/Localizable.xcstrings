    "Launch5.Handoff.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع على جهاز آخر من حيث توقفت تمامًا. ينقل Handoff أحدث أعمالك معك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্য ডিভাইসে ঠিক যেখানে থেমেছিলেন সেখান থেকে চালিয়ে যান। Handoff আপনার সর্বশেষ কাজ সঙ্গে নিয়ে যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na jiném zařízení pokračuj přesně tam, kde jsi skončil. Handoff přenese tvou poslední práci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt præcis, hvor du slap, på en anden enhed. Handoff tager dit seneste arbejde med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach auf einem anderen Gerät genau dort weiter, wo du aufgehört hast. Handoff bringt deine letzte Arbeit mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick up exactly where you left off on another device. Handoff brings your latest work along."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick up exactly where you left off on another device. Handoff brings your latest work along."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa exactamente donde lo dejaste en otro dispositivo. Handoff lleva contigo tu trabajo más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprends exactement où tu t’es arrêté sur un autre appareil. Handoff emporte ton travail le plus récent."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprends exactement où tu t’es arrêté sur un autre appareil. Handoff emporte ton travail le plus récent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे डिवाइस पर वहीं से जारी रखें जहाँ छोड़ा था। Handoff आपका सबसे नया काम साथ ले जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
