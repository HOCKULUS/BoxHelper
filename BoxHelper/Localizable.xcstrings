    "Der Abgleich läuft automatisch. Bei vielen Daten oder Fotos kann die erste Synchronisierung etwas dauern." : {
      "comment" : "A description of the time it takes to synchronize with iCloud.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المزامنة تعمل تلقائيًا. قد تستغرق المزامنة الأولية بعض الوقت إذا كان لديك الكثير من البيانات أو الصور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিঙ্ক্রোনাইজেশন স্বয়ংক্রিয়ভাবে চলে। আপনার কাছে অনেক ডেটা বা ফটো থাকলে প্রাথমিক সিঙ্ক কিছু সময় নিতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace probíhá automaticky. První synchronizace může při velkém množství dat či fotografií chvíli trvat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen foregår automatisk. Den første synkronisering kan tage tid ved mange data eller fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Abgleich läuft automatisch. Bei vielen Daten oder Fotos kann die erste Synchronisierung etwas dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronization runs automatically. The initial sync may take some time if you have a lot of data or photos."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronization runs automatically. The initial sync may take some time if you have a lot of data or photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización es automática. La primera sincronización puede tardar si hay muchos datos o fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation est automatique. La première synchronisation peut prendre du temps si tu as beaucoup de données ou de photos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation est automatique. La première synchronisation peut prendre du temps si tu as beaucoup de données ou de photos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक अपने आप होता है। बहुत अधिक डेटा या फ़ोटो होने पर पहले सिंक में समय लग सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione è automatica. La prima sincronizzazione può richiedere tempo se ci sono molti dati o foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
