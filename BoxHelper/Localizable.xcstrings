    "All text and selected images will be removed from the saved draft." : {
      "comment" : "A message displayed in a confirmation dialog that is shown when the user deletes a feedback draft.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
