        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez vos données pour les partager avec d’autres, restaurer une sauvegarde précédente ou supprimer la base de données et les médias."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने डेटा को दूसरों के साथ साझा करने, पुराना बैकअप पुनर्स्थापित करने या डेटाबेस और मीडिया हटाने के लिए निर्यात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esportare i dati per condividerli con altri, ripristinare un backup precedente o eliminare database e supporti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データを書き出して共有したり、以前のバックアップを復元したり、データベースやメディアを削除したりできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteer je data om te delen, een back-up terug te zetten of alles te wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuj dane, aby udostępniać je innym, przywrócić poprzednią kopię zapasową albo usunąć bazę danych i media."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export your data to share with others, restore a previous cópia de segurança, or delete database and media."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportera data för att dela dem, återställ en tidigare säkerhetskopia eller radera databasen och medier."
