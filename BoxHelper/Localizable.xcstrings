    "Generate a box QR code as a PNG file using the app's QR settings. The file can be saved, shared, or printed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنشاء رمز QR للصندوق كملف PNG باستخدام إعدادات QR في التطبيق. يمكن حفظ الملف أو مشاركته أو طباعته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপের QR সেটিং অনুযায়ী বাক্সের QR কোড PNG ফাইল হিসেবে তৈরি করে। ফাইলটি সংরক্ষণ, শেয়ার বা প্রিন্ট করা যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vygeneruje QR kód krabice jako soubor PNG podle nastavení QR v aplikaci. Soubor lze uložit, sdílet nebo vytisknout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genererer en kasses QR-kode som PNG-fil med appens QR-indstillinger. Filen kan gemmes, deles eller udskrives."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeuge den QR-Code einer Kiste als PNG-Datei mit den QR-Einstellungen der App. Die Datei kann gespeichert, geteilt oder gedruckt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generate a box QR code as a PNG file using the app's QR settings. The file can be saved, shared, or printed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generate a box QR code as a PNG file using the app's QR settings. The file can be saved, shared, or printed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera el código QR de una caja como archivo PNG con los ajustes QR de la app. El archivo puede guardarse, compartirse o imprimirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Génère le code QR d’une boîte au format PNG avec les réglages QR de l’app. Le fichier peut être enregistré, partagé ou imprimé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Génère le code QR d’une boîte au format PNG avec les réglages QR de l’app. Le fichier peut être enregistré, partagé ou imprimé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप की QR सेटिंग से डिब्बे का QR कोड PNG फ़ाइल के रूप में बनाता है। फ़ाइल सहेजी, साझा या प्रिंट की जा सकती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera il codice QR di una scatola come file PNG con le impostazioni QR dell’app. Il file può essere salvato, condiviso o stampato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの QR 設定を使い、箱の QR コードを PNG ファイルとして生成します。ファイルは保存、共有、プリントできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genereert de QR-code van een doos als PNG-bestand met de QR-instellingen van de app. Het bestand kan worden opgeslagen, gedeeld of afgedrukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generuje kod QR pudełka jako plik PNG, używając ustawień QR aplikacji. Plik można zapisać, udostępnić lub wydrukować."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gera o código QR de uma caixa como ficheiro PNG com as definições QR da aplicação. O ficheiro pode ser guardado, partilhado ou impresso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapar en lådas QR-kod som PNG-fil med appens QR-inställningar. Filen kan sparas, delas eller skrivas ut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın QR ayarlarıyla kutunun QR kodunu PNG dosyası olarak oluşturur. Dosya kaydedilebilir, paylaşılabilir veya yazdırılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Генерує QR-код коробки як файл PNG за налаштуваннями QR у застосунку. Файл можна зберегти, поширити або надрукувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用应用的 QR 设置，将箱子的 QR 码生成为 PNG 文件。文件可保存、共享或打印。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用應用程式的 QR 設定，將箱子的 QR 碼生成為 PNG 檔案。檔案可儲存、共享或打印。"
          }
