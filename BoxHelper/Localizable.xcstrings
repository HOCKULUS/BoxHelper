    "Die ausgewählten Kisten werden beim Speichern dem neuen Standort zugeordnet." : {
      "comment" : "A description of the effect of the \"Übernehmen\"-button in the `CreateLocationBoxesSheet`.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تعيين الصناديق المحددة إلى الموقع الجديد عند الحفظ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেভ করার পর নির্বাচিত বাক্সসমূহ নতুন অবস্থানে বরাদ্দ করা হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrané krabice se při uložení přiřadí k novému umístění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De valgte kasser tildeles den nye placering, når du gemmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählten Kisten werden beim Speichern dem neuen Standort zugeordnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected boxes will be assigned to the new location when you save."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected boxes will be assigned to the new location when you save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cajas seleccionadas se asignarán a la nueva ubicación al guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boîtes sélectionnées seront affectées au nouvel emplacement lors de l’enregistrement."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boîtes sélectionnées seront affectées au nouvel emplacement lors de l’enregistrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजने पर चुने हुए डिब्बे नए स्थान को सौंप दिए जाएँगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scatole selezionate verranno assegnate alla nuova posizione al salvataggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存すると、選択した箱を新しい場所に割り当てます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde dozen worden bij het opslaan aan de nieuwe locatie toegewezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane pudełka zostaną przypisane do nowej lokalizacji podczas zapisywania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As caixas selecionadas serão atribuídas à nova localização ao guardar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De valda lådorna tilldelas den nya platsen när du sparar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydederken seçilen kutular yeni konuma atanacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час збереження вибрані коробки буде призначено новому місцю."
