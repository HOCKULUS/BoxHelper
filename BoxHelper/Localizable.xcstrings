    "Launch5.SupportMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج BoxHelper إلى الكثير من الوقت والعمل. بوصفه مشروعًا مفتوح المصدر، يعتمد التطبيق على الأشخاص الذين يساهمون في تطويره ودعمه. شارك أفكارك أو أبلغ عن المشكلات أو ساهم بالشيفرة. كل مساهمة مهمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper-এ অনেক সময় ও শ্রম দেওয়া হয়। ওপেন-সোর্স প্রকল্প হিসেবে অ্যাপটি তাঁদের ওপর নির্ভরশীল যাঁরা উন্নয়ন ও সহায়তায় অংশ নেন। ভাবনা শেয়ার করুন, সমস্যা জানান বা কোড দিন। প্রতিটি অবদান গুরুত্বপূর্ণ।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper vyžaduje mnoho času a práce. Jako open source projekt závisí aplikace na lidech, kteří pomáhají s jejím vývojem a podporou. Sdílej nápady, nahlaš problémy nebo přispěj kódem. Každý příspěvek se počítá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper kræver meget tid og arbejde. Som open source-projekt afhænger appen af mennesker, der hjælper med at udvikle og støtte den. Del idéer, rapporter problemer eller bidrag med kode. Hvert bidrag tæller."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In BoxHelper steckt viel Zeit und Arbeit. Als Open-Source-Projekt lebt die App von Menschen, die mitgestalten und unterstützen. Teile deine Ideen, melde Fehler oder hilf am Code mit. Jede Beteiligung zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lot of time and work goes into BoxHelper. As an open-source project, the app depends on people who help shape and support it. Share ideas, report issues or contribute code. Every contribution counts."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lot of time and work goes into BoxHelper. As an open-source project, the app depends on people who help shape and support it. Share ideas, report issues or contribute code. Every contribution counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper requiere mucho tiempo y trabajo. Como proyecto de código abierto, la app depende de quienes contribuyen a desarrollarla y apoyarla. Comparte ideas, comunica problemas o aporta código. Cada contribución cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper demande beaucoup de temps et de travail. En tant que projet open source, l’app dépend des personnes qui contribuent à la faire évoluer et à la soutenir. Partage tes idées, signale des problèmes ou contribue au code. Chaque contribution compte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper demande beaucoup de temps et de travail. En tant que projet open source, l’app dépend des personnes qui contribuent à la faire évoluer et à la soutenir. Partage tes idées, signale des problèmes ou contribue au code. Chaque contribution compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper में बहुत समय और मेहनत लगती है। ओपन-सोर्स प्रोजेक्ट के रूप में यह ऐप उन लोगों पर निर्भर है जो इसे विकसित करने और सहयोग देने में मदद करते हैं। विचार साझा करें, समस्याएँ बताएँ या कोड दें। हर योगदान महत्वपूर्ण है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper richiede molto tempo e lavoro. Come progetto open source, l’app dipende dalle persone che contribuiscono a svilupparla e sostenerla. Condividi idee, segnala problemi o contribuisci al codice. Ogni contributo conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper には多くの時間と労力が注がれています。オープンソースのアプリとして、開発や支援に参加する人々に支えられています。アイデアの共有、問題の報告、コードの提供など、どんな貢献も役立ちます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er gaat veel tijd en werk in BoxHelper zitten. Als opensourceproject is de app afhankelijk van mensen die helpen bij de ontwikkeling en ondersteuning. Deel ideeën, meld problemen of draag code bij. Elke bijdrage telt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper wymaga wiele czasu i pracy. Jako projekt open source aplikacja zależy od osób, które pomagają ją rozwijać i wspierać. Dziel się pomysłami, zgłaszaj problemy lub dodawaj kod. Liczy się każdy wkład."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O BoxHelper exige muito tempo e trabalho. Como projeto de código aberto, a aplicação depende de quem ajuda a desenvolvê-la e a apoiá-la. Partilha ideias, comunica problemas ou contribui com código. Todos os contributos contam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper kräver mycket tid och arbete. Som projekt med öppen källkod är appen beroende av människor som utvecklar och stödjer den. Dela idéer, rapportera problem eller bidra med kod. Varje bidrag räknas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper çok zaman ve emek gerektirir. Açık kaynaklı bir proje olarak uygulama, gelişimine katkıda bulunan ve destekleyen insanlara bağlıdır. Fikir paylaşın, sorun bildirin veya kod katkısı yapın. Her katkı önemlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper потребує багато часу та праці. Як проєкт із відкритим кодом, застосунок залежить від людей, які допомагають його розвивати й підтримувати. Ділися ідеями, повідомляй про проблеми або додавай код. Кожен внесок важливий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper 凝聚了大量时间和努力。作为开源项目，这款应用依靠大家共同开发和支持。分享想法、报告问题或贡献代码，每一份贡献都很重要。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper 凝聚了大量時間和努力。作為開源項目，這款應用程式依靠大家共同開發和支持。分享想法、報告問題或貢獻代碼，每一份貢獻都很重要。"
          }
        }
      }
    },
