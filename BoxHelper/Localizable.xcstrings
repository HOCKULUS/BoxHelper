    "No need to reinvent the wheel. Just download and use these open source libraries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا داعي لإعادة اختراع العجلة. ما عليك سوى تنزيل هذه المكتبات مفتوحة المصدر واستخدامها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চাকা নতুন করে আবিষ্কার করার দরকার নেই। শুধু এই ওপেন সোর্স লাইব্রেরিগুলো ডাউনলোড করে ব্যবহার করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není třeba znovu vynalézat kolo. Stačí si stáhnout a použít tyto open source knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ingen grund til at opfinde den dybe tallerken. Download og brug bare disse open source-biblioteker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Grund, das Rad neu zu erfinden. Nutze einfach diese Open-Source-Bibliotheken."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to reinvent the wheel. Just download and use these open source libraries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hace falta reinventar la rueda. Solo descarga y usa estas bibliotecas de código abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas besoin de réinventer la roue. Téléchargez et utilisez simplement ces bibliothèques open source."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas besoin de réinventer la roue. Téléchargez et utilisez simplement ces bibliothèques open source."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहिया फिर से बनाने की ज़रूरत नहीं है। बस इन ओपन सोर्स लाइब्रेरीज़ को डाउनलोड करें और इस्तेमाल करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non serve reinventare la ruota. Scarica e usa queste librerie open source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車輪の再発明をする必要はありません。これらのオープンソースライブラリをダウンロードして使うだけで十分です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen reden om het wiel opnieuw uit te vinden. Gebruik gewoon deze open source-bibliotheken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma potrzeby wyważać otwartych drzwi. Po prostu pobierz i korzystaj z tych bibliotek open source."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to reinvent the wheel. Just download and use these open source libraries."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не потрібно винаходити велосипед. Просто завантажте та використовуйте ці бібліотеки з відкритим кодом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用重新发明輪子。只要下载並使用这些开源函式库即可。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用重新發明輪子。只要下載並使用這些開源函式庫即可。"
          }
        }
      }
    },
    "No personal data is ever transmitted to me. All your content is securely stored locally on your device." : {
      "comment" : "Answer about privacy and data transmission",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم إرسال أي بيانات شخصية إليّ مطلقًا. كل محتواك محفوظ محليًا وبشكل آمن على جهازك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কোনো ব্যক্তিগত ডেটা কখনও আমার কাছে পাঠানো হয় না। আপনার সব কনটেন্ট আপনার ডিভাইসেই নিরাপদভাবে লোকালি সংরক্ষিত থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikdy se mi nepřenášejí žádné osobní údaje. Veškerý váš obsah je bezpečně uložen lokálně na vašem zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der sendes aldrig personlige data til mig. Alt dit indhold opbevares sikkert lokalt på din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden keinerlei persönliche Daten an mich übermittelt. Alle Inhalte bleiben sicher lokal auf deinem Gerät gespeichert."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No personal data is ever transmitted to me. All your content is securely stored locally on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún dato personal se transmite. Todo se guarda localmente en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune donnée personnelle ne m’est jamais transmise. Tout votre contenu est stocké localement et en toute sécurité sur votre appareil."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune donnée personnelle ne m’est jamais transmise. Tout votre contenu est stocké localement et en toute sécurité sur votre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी व्यक्तिगत डेटा मुझ तक कभी नहीं भेजा जाता। आपकी सारी सामग्री सुरक्षित रूप से आपके डिवाइस पर ही स्थानीय रूप से संग्रहीत रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun dato personale viene trasmesso. Tutto resta sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人データが私に送信されることは一切ありません。すべてのコンテンツはあなたのデバイス内に安全にローカル保存されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt nooit persoonlijke data verzonden. Alles blijft veilig opgeslagen op je apparaat.\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadne dane osobowe nigdy nie są do mnie przesyłane. Cała zawartość jest bezpiecznie przechowywana lokalnie na Twoim urządzeniu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No personal data is ever transmitted to me. All your content is securely stored locally on your device."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодні персональні дані ніколи не передаються мені. Увесь ваш вміст безпечно зберігається локально на вашому пристрої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的个人资料不会传送給我。所有内容都会安全地存储在你的设备本机。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的個人資料不會傳送給我。所有內容都會安全地儲存在你的裝置本機。"
          }
        }
      }
    },
