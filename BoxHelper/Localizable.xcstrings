    "Launch5.Cloud.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى الانتظار: يربط SwiftData الآن مخزونك بـ iCloud. شاركه مع عائلتك أو فريق الانتقال. وداعًا، UserDefaults!"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অপেক্ষা শেষ: SwiftData এখন আপনার ইনভেন্টরিকে iCloud-এর সঙ্গে যুক্ত করে। পরিবার বা বাসা বদলের দলের সঙ্গে শেয়ার করুন। বিদায়, UserDefaults!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čekání skončilo: SwiftData nyní propojuje tvůj inventář s iCloudem. Sdílej ho s rodinou nebo týmem pro stěhování. Sbohem, UserDefaults!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventetiden er slut: SwiftData forbinder nu dit inventar med iCloud. Del det med familien eller dit flyttehold. Farvel, UserDefaults!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Warten hat ein Ende: Dank SwiftData ist dein Inventar jetzt mit iCloud verbunden. Teile es mit deiner Familie oder deinen Umzugshelfern. Tschüss, UserDefaults!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wait is over: SwiftData now connects your inventory to iCloud. Share it with your family or your moving crew. Goodbye, UserDefaults!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wait is over: SwiftData now connects your inventory to iCloud. Share it with your family or your moving crew. Goodbye, UserDefaults!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La espera ha terminado: SwiftData conecta ahora tu inventario con iCloud. Compártelo con tu familia o tu equipo de mudanza. ¡Adiós, UserDefaults!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attente est terminée : SwiftData relie désormais ton inventaire à iCloud. Partage-le avec ta famille ou ton équipe de déménagement. Adieu, UserDefaults !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attente est terminée : SwiftData relie désormais ton inventaire à iCloud. Partage-le avec ta famille ou ton équipe de déménagement. Adieu, UserDefaults !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंतज़ार खत्म: SwiftData अब आपकी इन्वेंटरी को iCloud से जोड़ता है। इसे अपने परिवार या सामान स्थानांतरित करने वाली टीम के साथ साझा करें। अलविदा, UserDefaults!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attesa è finita: SwiftData ora collega il tuo inventario a iCloud. Condividilo con la famiglia o con chi ti aiuta a traslocare. Addio, UserDefaults!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お待たせしました。SwiftData がインベントリを iCloud に接続します。家族や引っ越し仲間と共有しましょう。さようなら、UserDefaults！"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wachten is voorbij: SwiftData verbindt je inventaris nu met iCloud. Deel deze met je gezin of verhuisploeg. Vaarwel, UserDefaults!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koniec czekania: SwiftData łączy teraz Twój inwentarz z iCloud. Udostępnij go rodzinie lub ekipie do przeprowadzki. Żegnaj, UserDefaults!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A espera terminou: o SwiftData liga agora o teu inventário ao iCloud. Partilha-o com a família ou com quem te ajuda na mudança. Adeus, UserDefaults!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntan är över: SwiftData kopplar nu ditt inventarium till iCloud. Dela med familjen eller flytthjälpen. Farväl, UserDefaults!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekleyiş bitti: SwiftData artık envanterinizi iCloud’a bağlıyor. Ailenizle veya taşınma ekibinizle paylaşın. Elveda, UserDefaults!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очікування закінчилося: SwiftData тепер підключає твій інвентар до iCloud. Поділися ним із родиною або командою для переїзду. Прощавай, UserDefaults!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待结束：SwiftData 现在可将你的库存连接到 iCloud。与家人或搬家伙伴共享吧。再见，UserDefaults！"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待結束：SwiftData 現在可將你的庫存連接到 iCloud。與家人或搬傢伙伴共享吧。再見，UserDefaults！"
          }
        }
      }
    },
