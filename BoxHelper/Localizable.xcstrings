    "QRBatchPrint.EcoHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وفّر الورق: لا تحتاج إلى طباعة كل صندوق. يمكن جمع عدة رموز QR في صفحة واحدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাগজ বাঁচান: প্রতিটি বাক্স প্রিন্ট করতে হবে না। এক পাতায় একাধিক QR কোড রাখা যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šetři papír: nemusíš tisknout každou krabici. Na jednu stránku se vejde více QR kódů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spar papir: Du behøver ikke udskrive hver kasse. Flere QR-koder kan være på samme side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spare Papier: Du musst nicht alle Kisten drucken. Mehrere QR-Codes passen auf eine Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save paper: You don’t have to print every box. Several QR codes can share a page."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save paper: You don’t have to print every box. Several QR codes can share a page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahorra papel: no tienes que imprimir todas las cajas. Varios códigos QR pueden compartir una página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Économise du papier : tu n’as pas besoin d’imprimer chaque boîte. Plusieurs codes QR peuvent tenir sur une même page."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Économise du papier : tu n’as pas besoin d’imprimer chaque boîte. Plusieurs codes QR peuvent tenir sur une même page."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कागज़ बचाएँ: हर डिब्बे को प्रिंट करना ज़रूरी नहीं है। एक पृष्ठ पर कई QR कोड रखे जा सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risparmia carta: non devi stampare ogni scatola. Più codici QR possono condividere una pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用紙を節約しましょう。すべての箱をプリントする必要はありません。複数の QR コードを1ページにまとめられます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bespaar papier: je hoeft niet elke doos af te drukken. Meerdere QR-codes passen op één pagina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszczędzaj papier: nie musisz drukować każdego pudełka. Kilka kodów QR może być na jednej stronie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poupa papel: não tens de imprimir todas as caixas. Vários códigos QR podem partilhar uma página."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara papper: du behöver inte skriva ut varje låda. Flera QR-koder får plats på samma sida."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kâğıt tasarrufu yapın: her kutuyu yazdırmanız gerekmez. Birden fazla QR kodu aynı sayfaya sığabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заощаджуй папір: не потрібно друкувати кожну коробку. Кілька QR-кодів можна розмістити на одній сторінці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节省纸张：无需打印每个箱子。多个 QR 码可放在同一页上。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "節省紙張：無需打印每個箱子。多個 QR 碼可放在同一頁上。"
          }
        }
      }
