    "No mail account is configured on this device. Please set up Mail first." : {
      "comment" : "A message displayed when the user tries to send feedback via mail but no mail account is configured on their device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto zařízení není nastaven žádný poštovní účet. Nejprve nastavte Mail."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke konfigureret en mailkonto på denne enhed. Konfigurer først Mail."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät ist kein Mail-Konto eingerichtet. Bitte richte zuerst Mail ein."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
