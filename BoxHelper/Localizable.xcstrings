        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🖼️ নতুন Images ট্যাব আপনার সব কনটেন্টের দ্রুত ওভারভিউ দেয়। বাক্স ও আইটেমের ছবি একসঙ্গে দেখানো হয়, তাই খুঁজে পাওয়া সহজ।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🖼️ Nová karta obrázků vám poskytne rychlý přehled o veškerém obsahu. Obrázky z krabic i položek se zobrazují společně, takže je hledání snazší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🖼️ En ny billedfane giver dig et hurtigt overblik over alt dit indhold. Billeder fra kasser og genstande vises samlet, så det er lettere at søge."
