    "Verwalte hier alle App-Hinweise. Du kannst sie komplett beenden oder den Fortschritt aller Tips zurücksetzen." : {
      "comment" : "A description of the functionality of the \"Tips\" section in the settings view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم هنا بإدارة جميع تلميحات التطبيق. يمكنك إنهاؤها بالكامل أو إعادة تعيين تقدم جميع التلميحات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখানে অ্যাপের সব টিপস পরিচালনা করুন। আপনি সেগুলো পুরোপুরি শেষ করতে পারেন বা সব টিপসের অগ্রগতি রিসেট করতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde spravujete všechny tipy aplikace. Můžete je úplně ukončit nebo resetovat průběh všech tipů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrér alle appens tips her. Du kan afslutte dem helt eller nulstille fremskridtet for alle tips."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalte hier alle App-Hinweise. Du kannst sie komplett beenden oder den Fortschritt aller Tips zurücksetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage all app tips here. You can end them completely or reset the progress of all tips."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage all app tips here. You can end them completely or reset the progress of all tips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona aquí todos los consejos de la app. Puedes finalizarlos por completo o restablecer el progreso de todos los consejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez ici toutes les astuces de l’app. Vous pouvez les terminer complètement ou réinitialiser la progression de tous les conseils."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez ici toutes les astuces de l’app. Vous pouvez les terminer complètement ou réinitialiser la progression de tous les conseils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ सभी ऐप सुझावों का प्रबंधन करें। आप इन्हें पूरी तरह समाप्त कर सकते हैं या सभी सुझावों की प्रगति रीसेट कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestisci qui tutti i suggerimenti dell’app. Puoi terminarli completamente o reimpostare il progresso di tutti i suggerimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
