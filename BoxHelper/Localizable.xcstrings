    "Hold and drag images to reorder it. Change the default order in the box settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولاً واسحب الصور لإعادة ترتيبها. غيّر الترتيب الافتراضي من إعدادات الصندوق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ছবির ক্রম পরিবর্তন করতে চেপে ধরে টেনে আনুন। ডিফল্ট ক্রম বাক্সের সেটিংসে পরিবর্তন করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte a přetáhněte obrázky pro změnu pořadí. Výchozí pořadí můžete změnit v nastavení krabice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold og træk billeder for at ændre rækkefølgen. Skift standardrækkefølgen i kasseindstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder halten und ziehen, um die Reihenfolge zu ändern. Die Standardreihenfolge lässt sich in den Kisten-Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold and drag images to reorder it. Change the default order in the box settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold and drag images to reorder it. Change the default order in the box settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado y arrastra imágenes para reordenarlas.\nPuedes cambiar el orden por defecto en los ajustes de la caja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez et faites glisser les images pour les réorganiser. Modifiez l’ordre par défaut dans les réglages de la boîte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez et faites glisser les images pour les réorganiser. Modifiez l’ordre par défaut dans les réglages de la boîte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चित्रों का क्रम बदलने के लिए उन्हें दबाकर खींचें। डिफ़ॉल्ट क्रम डिब्बे की सेटिंग्स में बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenere premuto e trascinare le immagini per riordinarle. Modificare l'ordine predefinito nelle impostazioni del riquadro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像を長押ししてドラッグすると並べ替えられます。デフォルトの順序は箱の設定で変更できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd afbeeldingen vast en sleep om te herschikken. Wijzig de standaardvolgorde via boxinstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj i przeciągnij obrazy, aby zmienić ich kolejność. Domyślną kolejność zmienisz w ustawieniach pudełka."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold and drag imagems to reorder it. Change the default order in the caixa settings."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll och dra bilder för att ändra ordningen. Ändra standardordningen i lådinställningarna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıralamayı değiştirmek için görselleri basılı tutup sürükleyin. Varsayılan sırayı kutu ayarlarında değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте та перетягуйте зображення, щоб змінити їх порядок. Змініть порядок за замовчуванням у налаштуваннях коробки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住並拖曳图片即可重新排序。你也可以在箱子设置中更改预设排序。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住並拖曳圖片即可重新排序。你也可以在箱子設定中更改預設排序。"
          }
        }
      }
    },
