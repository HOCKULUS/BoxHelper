    "Launch5.Bugs.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُضيفت أيضًا بعض الأخطاء الجديدة أثناء العمل. كن أول من يعثر عليها ويبلغ عنها على GitHub!"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পথে কয়েকটি নতুন বাগও যোগ হয়েছে। সবার আগে সেগুলো খুঁজে GitHub-এ জানান!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestou přibylo i pár nových chyb. Najdi je jako první a nahlas je na GitHubu!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er også kommet et par nye fejl undervejs. Find dem som den første, og rapporter dem på GitHub!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganz nebenbei wurden auch ein paar neue Bugs eingebaut. Finde sie zuerst und melde sie auf GitHub!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A few new bugs were thrown in along the way, too. Be the first to find them and report them on GitHub!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A few new bugs were thrown in along the way, too. Be the first to find them and report them on GitHub!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se han colado algunos errores nuevos. ¡Sé el primero en encontrarlos y notificarlos en GitHub!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques nouveaux bugs se sont aussi glissés en chemin. Sois le premier à les trouver et à les signaler sur GitHub !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques nouveaux bugs se sont aussi glissés en chemin. Sois le premier à les trouver et à les signaler sur GitHub !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रास्ते में कुछ नए बग भी आ गए हैं। सबसे पहले उन्हें ढूँढें और GitHub पर बताएँ!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada facendo si sono aggiunti anche alcuni nuovi bug. Trovali per primo e segnalali su GitHub!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいバグも少し紛れ込みました。いち早く見つけて GitHub で報告してください！"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderweg zijn er ook een paar nieuwe bugs bij gekomen. Vind ze als eerste en meld ze op GitHub!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po drodze pojawiło się też kilka nowych błędów. Znajdź je jako pierwszy i zgłoś na GitHubie!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo caminho, também apareceram alguns erros novos. Sê o primeiro a encontrá-los e a comunicá-los no GitHub!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Några nya fel har också smugit sig in. Var först med att hitta dem och rapportera på GitHub!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu arada birkaç yeni hata da eklendi. İlk bulan siz olun ve GitHub’da bildirin!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дорогою додалося й кілька нових помилок. Знайди їх першим і повідом про них на GitHub!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当然，途中也加入了几个新错误。抢先找到它们并在 GitHub 上报告吧！"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當然，途中也加入了幾個新錯誤。搶先找到它們並在 GitHub 上報告吧！"
          }
        }
      }
    },
