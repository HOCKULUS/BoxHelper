    "BoxHelper unlocks powerful accessibility and lets you automate your inventory like never before." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنحك BoxHelper إمكانات وصول قوية ويتيح لك أتمتة مخزونك بطريقة غير مسبوقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper শক্তিশালী অ্যাক্সেসিবিলিটি সুবিধা দেয় এবং আপনার ইনভেন্টরি আগের চেয়ে বেশি স্বয়ংক্রিয় করতে সাহায্য করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper odemyká pokročilé funkce zpřístupnění a umožňuje vám automatizovat inventář jako nikdy předtím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper giver stærke tilgængelighedsfunktioner og lader dig automatisere dit inventar som aldrig før."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper bietet leistungsstarke Barrierefreiheit und ermöglicht eine nie dagewesene Automatisierung vom Inventar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper unlocks powerful accessibility and lets you automate your inventory like never before."
          }
        },
