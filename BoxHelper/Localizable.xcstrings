    "Alle Bilder werden gelöscht und aus Kisten, Gegenständen und Standorten entfernt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف جميع الصور وإزالتها من الصناديق والعناصر والمواقع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সব ছবি মুছে ফেলা হবে এবং বাক্স, আইটেম ও অবস্থান থেকে সরানো হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny obrázky budou smazány a odstraněny z krabic, položek i umístění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle billeder slettes og fjernes fra kasser, genstande og placeringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
