    "CreatePreferences.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر النموذج الأولي. استمر في النماذج المفتوحة والبحث على جهاز آخر باستخدام Handoff. تظل المدخلات متاحة خلال جلسة هذا التطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্টার্টআপ ফর্ম নির্বাচন করুন। অন্য ডিভাইসে হ্যান্ডঅফ দিয়ে চলমান খোলা ফর্ম এবং সার্চ চালিয়ে যান। এই অ্যাপ সেশনের সময় ইনপুট উপলব্ধ থাকবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber úvodní formulář. Pomocí Handoff můžeš pokračovat v otevřených formulářích a vyhledávání na jiném zařízení. Zadání zůstávají dostupná během této relace aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg startformularen. Fortsæt åbne formularer og søgninger på en anden enhed med Handoff. Indtastningerne forbliver tilgængelige under denne appsession."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Startformular. Offene Formulare und Suchen lassen sich mit Handoff auf einem anderen Gerät fortsetzen. Eingaben bleiben während dieser App-Sitzung erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the startup form. Continue open forms and searches on another device with Handoff. Inputs remain available during this app session."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the startup form. Continue open forms and searches on another device with Handoff. Inputs remain available during this app session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el formulario inicial. Continúa los formularios y búsquedas abiertos en otro dispositivo mediante Handoff. Los datos introducidos permanecen disponibles durante esta sesión de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis le formulaire de démarrage. Poursuis les formulaires et recherches ouverts sur un autre appareil avec Handoff. Les saisies restent disponibles pendant cette session de l’app."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis le formulaire de démarrage. Poursuis les formulaires et recherches ouverts sur un autre appareil avec Handoff. Les saisies restent disponibles pendant cette session de l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरुआती फ़ॉर्म चुनें। Handoff की मदद से खुले फ़ॉर्म और खोज दूसरे डिवाइस पर जारी रखें। इस ऐप सत्र के दौरान दर्ज की गई जानकारी उपलब्ध रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il modulo iniziale. Continua moduli e ricerche aperti su un altro dispositivo con Handoff. I dati inseriti restano disponibili durante questa sessione dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時のフォームを選択します。開いているフォームや検索を、Handoff で別のデバイスから続けられます。入力内容はこのアプリのセッション中保持されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies het startformulier. Ga met Handoff op een ander apparaat verder met open formulieren en zoekopdrachten. Ingevoerde gegevens blijven tijdens deze appsessie beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz formularz początkowy. Kontynuuj otwarte formularze i wyszukiwania na innym urządzeniu dzięki Handoff. Wpisane dane pozostają dostępne podczas tej sesji aplikacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe o formulário inicial. Continua formulários e pesquisas abertos noutro dispositivo com o Handoff. Os dados introduzidos permanecem disponíveis durante esta sessão da aplicação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj startformuläret. Fortsätt öppna formulär och sökningar på en annan enhet med Handoff. Inmatningen behålls under den här appsessionen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlangıç formunu seçin. Açık formları ve aramaları Handoff ile başka bir cihazda sürdürün. Girilen bilgiler bu uygulama oturumu boyunca korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибери початкову форму. Продовжуй відкриті форми й пошуки на іншому пристрої через Handoff. Введені дані залишаються доступними протягом цього сеансу застосунку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择启动表单。通过 Handoff 在其他设备上继续打开的表单和搜索。本次应用会话期间，已输入的内容会保留。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇啓動表單。通過 Handoff 在其他設備上繼續打開的表單和搜索。本次應用程式會話期間，已輸入的內容會保留。"
          }
        }
      }
