    "CreateItem.DictationPermissionsRequired" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الميكروفون والتعرف على الكلام في الإعدادات، أو أوقف الإملاء الصوتي لبدء الالتقاط التلقائي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় ক্যাপচার শুরু করতে সেটিংসে মাইক্রোফোন এবং স্পিচ রিকগনিশন অ্যাক্সেস অনুমতি দিন, অথবা ডিক্টেশন বন্ধ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povol v Nastavení přístup k mikrofonu a rozpoznávání řeči, nebo vypni diktování, aby bylo možné spustit automatické zaznamenávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad mikrofon og talegenkendelse i Indstillinger, eller slå diktering fra for at starte automatisk registrering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf Mikrofon und Spracherkennung in den Einstellungen oder schalte Diktieren aus, um die Automatik zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow microphone and speech recognition access in Settings, or turn off dictation to start automatic capture."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow microphone and speech recognition access in Settings, or turn off dictation to start automatic capture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso al micrófono y al reconocimiento de voz en Ajustes, o desactiva el dictado para iniciar la captura automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l’accès au microphone et à la reconnaissance vocale dans les réglages, ou désactive la dictée pour démarrer la saisie automatique."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l’accès au microphone et à la reconnaissance vocale dans les réglages, ou désactive la dictée pour démarrer la saisie automatique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग में माइक्रोफ़ोन और वाक् पहचान की अनुमति दें, या स्वचालित कैप्चर शुरू करने के लिए बोलकर नाम देने की सुविधा बंद करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso al microfono e al riconoscimento vocale nelle Impostazioni, oppure disattiva la dettatura per avviare l’acquisizione automatica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でマイクと音声認識へのアクセスを許可するか、音声入力をオフにして自動撮影を開始してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta microfoon- en spraakherkenningstoegang toe in Instellingen, of schakel dicteren uit om de automatische registratie te starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na dostęp do mikrofonu i rozpoznawania mowy w Ustawieniach lub wyłącz dyktowanie, aby rozpocząć automatyczne rejestrowanie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite o acesso ao microfone e ao reconhecimento de voz nas Definições, ou desativa o ditado para iniciar o registo automático."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt mikrofon och taligenkänning i Inställningar, eller stäng av diktering för att starta automatisk registrering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik kaydı başlatmak için Ayarlar’da mikrofon ve konuşma tanıma erişimine izin verin veya dikteyi kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволь доступ до мікрофона й розпізнавання мовлення в Параметрах або вимкни диктування, щоб розпочати автоматичне додавання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设置中允许访问麦克风和语音识别，或关闭听写后再开始自动拍摄。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在設定中允許存取麥克風和語音識別，或關閉聽寫後再開始自動拍攝。"
          }
        }
      }
    },
