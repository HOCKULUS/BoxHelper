    "Define how your boxes should be named automatically. Choose between a unique ID or a combination of sequential numbers and custom text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد كيف يجب تسمية الصناديق تلقائياً. اختر بين معرف فريد أو مزيج من الأرقام المتسلسلة ونص مخصص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বাক্সগুলোর নাম স্বয়ংক্রিয়ভাবে কীভাবে হবে তা নির্ধারণ করুন। একটি অনন্য ID অথবা ধারাবাহিক নম্বর ও কাস্টম টেক্সটের সংমিশ্রণ থেকে বেছে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Určete, jak se mají vaše krabice automaticky pojmenovávat. Vyberte si mezi jedinečným ID nebo kombinací pořadových čísel a vlastního textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestem, hvordan dine kasser automatisk skal navngives. Vælg mellem et unikt ID eller en kombination af fortløbende numre og brugerdefineret tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wie deine Kisten automatisch benannt werden sollen. Wähle zwischen einer eindeutigen ID oder einer Kombination aus fortlaufenden Zahlen und eigenem Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define how your boxes should be named automatically. Choose between a unique ID or a combination of sequential numbers and custom text."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define how your boxes should be named automatically. Choose between a unique ID or a combination of sequential numbers and custom text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define cómo se nombrarán automáticamente tus cajas.\nElige entre un ID único o una combinación de números y texto personalizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez comment vos boîtes doivent être nommées automatiquement. Choisissez entre un identifiant unique ou une combinaison de numéros séquentiels et de texte personnalisé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez comment vos boîtes doivent être nommées automatiquement. Choisissez entre un identifiant unique ou une combinaison de numéros séquentiels et de texte personnalisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्धारित करें कि आपके डिब्बों के नाम स्वतः कैसे रखे जाएँ। एक अद्वितीय ID या क्रमिक संख्याओं और कस्टम पाठ के संयोजन में से चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definire il nome automatico delle caselle. Scegliete tra un ID unico o una combinazione di numeri sequenziali e testo personalizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "箱の自動命名方法を設定します。一意のID、または連番と任意のテキストの組み合わせを選べます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel in hoe boxen automatisch worden genoemd: met unieke ID of een combinatie van nummer en tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Określ, jak Twoje pudełka mają być nazywane automatycznie. Wybierz między unikalnym ID a kombinacją kolejnych numerów i własnego tekstu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define how your caixaes should be named automatically. Choose between a unique ID or a combination of sequential numbers and custom text."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestäm hur lådorna ska namnges automatiskt. Välj ett unikt ID eller en kombination av löpnummer och egen text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutuların otomatik nasıl adlandırılacağını belirleyin. Benzersiz ID veya sıralı numaralarla özel metnin birleşimini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визначте, як ваші коробки мають називатися автоматично. Виберіть між унікальним ID або комбінацією послідовних номерів і власного тексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定義你的箱子应如何自动命名。可选择使用唯一識别码，或是序号与自訂文字的組合。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定義你的箱子應如何自動命名。可選擇使用唯一識別碼，或是序號與自訂文字的組合。"
          }
        }
      }
    },
    "Dein gesamtes Inventar und zukünftig angelegte Daten werden geteilt." : {
      "comment" : "The text that appears under the \"Daten\" picker in the \"New Inventory Share\" view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم مشاركة كامل مخزونك وأي بيانات يتم إنشاؤها في المستقبل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সম্পূর্ণ ইনভেন্টরি এবং ভবিষ্যতে তৈরি যেকোনো ডেটা শেয়ার করা হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílí se celý tvůj inventář i data vytvořená v budoucnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele dit inventar og fremtidige data deles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein gesamtes Inventar und zukünftig angelegte Daten werden geteilt."
