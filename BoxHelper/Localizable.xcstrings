        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der eingestellten Inaktivitätszeit wurden keine Änderungen erkannt. Die Automatik wurde ausgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No changes were detected during the configured inactivity period. Automatic capture has been switched off."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No changes were detected during the configured inactivity period. Automatic capture has been switched off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se detectaron cambios durante el periodo de inactividad configurado. La captura automática se ha desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun changement n’a été détecté pendant la durée d’inactivité configurée. La saisie automatique a été désactivée."
