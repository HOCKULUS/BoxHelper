        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হ্যাঁ, আপনি আপনার ব্যাকআপ এক্সপোর্ট করে যেকোনো ZIP প্রোগ্রাম দিয়ে খুলে কাঁচা ডেটা দেখতে বা সম্পাদনা করতে পারেন। শুধু নিশ্চিত করুন যেন ভেতরের ফোল্ডার কাঠামো পরিবর্তন না হয়। ডেটা আবার কমপ্রেস করার সময় অতিরিক্ত উপরের স্তরের ফোল্ডার যোগ করবেন না। মূল কাঠামো অক্ষুণ্ণ থাকতে হবে, নইলে ইমপোর্ট ব্যর্থ হতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
