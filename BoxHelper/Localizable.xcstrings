    "If enabled every value you fill in the Create-Tab will be saved on app launch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تم التفعيل، فسيتم حفظ كل قيمة تُدخلها في علامة تبويب الإنشاء عند تشغيل التطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি চালু থাকলে Create ট্যাবে আপনি যে মানগুলো পূরণ করবেন সেগুলো অ্যাপ চালুর সময় সংরক্ষিত থাকবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je zapnuto, každá hodnota zadaná na kartě Vytvořit se uloží při spuštění aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er aktiveret, gemmes alle værdier, du indtaster i Opret-fanen, når appen startes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wird jeder Wert, den du im Erstellen-Tab eingibst, beim Start der App gespeichert."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled every value you fill in the Create-Tab will be saved on app launch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, cada valor que introduzcas en la pestaña Crear se guardará al iniciar la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, chaque valeur que vous saisissez dans l’onglet de création sera enregistrée au lancement de l’app."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, chaque valeur que vous saisissez dans l’onglet de création sera enregistrée au lancement de l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि सक्षम किया गया है, तो बनाएँ टैब में भरा गया हर मान ऐप लॉन्च होने पर सहेजा जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivato, ogni valore che inserisci nella scheda Crea verrà salvato all’avvio dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、作成タブに入力した内容はアプリ起動時にも保存されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, wordt elke waarde die je invult in het tabblad Aanmaken opgeslagen bij het starten van de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli ta opcja jest włączona, każda wartość wpisana na karcie tworzenia zostanie zapisana przy uruchomieniu aplikacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled every value you fill in the Create-Tab will be saved on app launch."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, кожне значення, яке ви вводите у вкладці створення, буде збережене під час запуску додатка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果启用，你在建立分页中输入的每个值都会在 App 启动时保留。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果啟用，你在建立分頁中輸入的每個值都會在 App 啟動時保留。"
          }
        }
      }
    },
    "If enabled, box, item and location names are indexed in iOS Spotlight search." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تم التفعيل، فسيتم فهرسة أسماء الصناديق والعناصر والمواقع في بحث Spotlight على iOS."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি চালু থাকলে বাক্স, আইটেম ও অবস্থানের নাম iOS Spotlight অনুসন্ধানে সূচীকৃত হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je zapnuto, názvy krabic, položek a umístění se indexují ve vyhledávání Spotlight v iOS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er aktiveret, indekseres navne på kasser, genstande og placeringer i iOS Spotlight-søgning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Kisten-, Gegenstands- und Standortnamen in der iOS-Spotlight-Suche indexiert."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, box, item and location names are indexed in iOS Spotlight search."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los nombres de cajas, objetos y ubicaciones se indexarán en la búsqueda Spotlight de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les noms des boîtes, des éléments et des emplacements sont indexés dans la recherche Spotlight d’iOS."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les noms des boîtes, des éléments et des emplacements sont indexés dans la recherche Spotlight d’iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि सक्षम किया गया है, तो डिब्बे, वस्तु और स्थान के नाम iOS स्पॉटलाइट खोज में अनुक्रमित किए जाएँगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivato, i nomi di scatole, elementi e posizioni vengono indicizzati nella ricerca Spotlight di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、箱・アイテム・場所の名前が iOS Spotlight 検索に索引登録されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, worden doos-, item- en locatienamen geïndexeerd in iOS Spotlight-zoekopdracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu tej opcji nazwy pudełek, przedmiotów i lokalizacji będą indeksowane w wyszukiwarce Spotlight w iOS."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, caixa, item and localização names are indexed in iOS Spotlight search."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, назви коробок, елементів і локацій індексуються в пошуку Spotlight iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果启用，箱子、物品和位置名稱会加入 iOS Spotlight 搜索索引。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果啟用，箱子、物品和位置名稱會加入 iOS Spotlight 搜尋索引。"
          }
        }
      }
    },
    "If some Tags are not spefic enough, you can block them by clicking on 🚫. Blocked Tags will be shown here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كانت بعض العلامات غير محددة بما فيه الكفاية، يمكنك حظرها بالنقر على 🚫. ستظهر العلامات المحظورة هنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যদি কিছু ট্যাগ যথেষ্ট নির্দিষ্ট না হয়, তবে 🚫-এ ক্লিক করে সেগুলো ব্লক করতে পারেন। ব্লক করা ট্যাগগুলো এখানে দেখানো হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud některé značky nejsou dostatečně přesné, můžete je zablokovat kliknutím na 🚫. Blokované značky se zobrazí zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis nogle tags ikke er specifikke nok, kan du blokere dem ved at trykke på 🚫. Blokerede tags vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Tags zu ungenau sind, kannst du sie mit 🚫 blockieren. Gesperrte Tags werden hier angezeigt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If some Tags are not spefic enough, you can block them by clicking on 🚫. Blocked Tags will be shown here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si algunas etiquetas no son útiles, puedes bloquearlas con 🚫.\nAquí se mostrarán las etiquetas bloqueadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si certaines étiquettes ne sont pas assez précises, vous pouvez les bloquer en cliquant sur 🚫. Les étiquettes bloquées seront affichées ici."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si certaines étiquettes ne sont pas assez précises, vous pouvez les bloquer en cliquant sur 🚫. Les étiquettes bloquées seront affichées ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि कुछ टैग पर्याप्त विशिष्ट नहीं हैं, तो आप 🚫 पर क्लिक करके उन्हें अवरुद्ध कर सकते हैं। अवरुद्ध टैग यहाँ दिखेंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcuni tag non sono abbastanza specifici, è possibile bloccarli facendo clic su 🚫. I tag bloccati saranno mostrati qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のタグが十分に具体的でない場合は、🚫 をタップしてブロックできます。ブロックしたタグはここに表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als sommige tags te vaag zijn, kun je ze blokkeren met 🚫. Ze verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli niektóre tagi nie są wystarczająco precyzyjne, możesz je zablokować, klikając 🚫. Zablokowane tagi będą pokazane tutaj."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If some Tags are not spefic enough, you can block them by clicking on 🚫. Blocked Tags will be shown here."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо деякі мітки недостатньо точні, ви можете заблокувати їх, натиснувши 🚫. Заблоковані мітки буде показано тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果某些标签不夠精確，你可以按一下 🚫 将其封鎖。被封鎖的标签会显示在这里。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果某些標籤不夠精確，你可以按一下 🚫 將其封鎖。被封鎖的標籤會顯示在這裡。"
          }
        }
      }
    },
    "If you plan to reuse a QR code later, you should consider disabling the location." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت تخطط لإعادة استخدام رمز QR لاحقاً، فمن الأفضل التفكير في تعطيل الموقع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরে আবার QR কোড ব্যবহার করার পরিকল্পনা থাকলে অবস্থান নিষ্ক্রিয় করার কথা বিবেচনা করা উচিত।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud plánujete QR kód později znovu použít, zvažte deaktivaci umístění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du planlægger at genbruge en QR-kode senere, bør du overveje at deaktivere placeringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen QR-Code später wiederverwenden willst, solltest du den Standort deaktivieren."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you plan to reuse a QR code later, you should consider disabling the location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si planeas reutilizar un código QR más tarde, considera desactivar la ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous prévoyez de réutiliser un code QR plus tard, vous devriez envisager de désactiver l’emplacement."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous prévoyez de réutiliser un code QR plus tard, vous devriez envisager de désactiver l’emplacement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप बाद में QR कोड पुनः उपयोग करना चाहते हैं, तो स्थान को निष्क्रिय करने पर विचार करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se si prevede di riutilizzare un codice QR in un secondo momento, si dovrebbe considerare la possibilità di disabilitare la posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとで QR コードを再利用する予定がある場合は、場所の印刷を無効にすることを検討してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een QR-code later opnieuw wilt gebruiken, schakel dan de locatie uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli planujesz później ponownie użyć kodu QR, rozważ wyłączenie lokalizacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you plan to reuse a QR code later, you should consider disabling the localização."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви плануєте пізніше повторно використовувати QR-код, варто розглянути вимкнення локації."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你之后打算重用某个 QR Code，建议你停用位置资讯。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你之後打算重用某個 QR Code，建議你停用位置資訊。"
          }
        }
      }
    },
