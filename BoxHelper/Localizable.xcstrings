          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tekst og valgte billeder fjernes fra det gemte udkast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gesamte Text und alle ausgewählten Bilder werden aus dem gespeicherten Entwurf entfernt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All text and selected images will be removed from the saved draft."
          }
        },
        "es" : {
          "stringUnit" : {
