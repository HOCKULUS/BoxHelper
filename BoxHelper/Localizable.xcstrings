    "Add one or more photos to an item and recognize tags in the background. Returns the saved image file names." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف صورة واحدة أو أكثر إلى عنصر واكتشف الوسوم في الخلفية. يعيد أسماء ملفات الصور المحفوظة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি আইটেমে একটি বা একাধিক ফটো যোগ করুন এবং ব্যাকগ্রাউন্ডে ট্যাগ স্বীকার করুন। সংরক্ষিত ইমেজ ফাইলের নাম প্রদান করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá k položce jednu nebo více fotografií a rozpozná štítky na pozadí. Vrátí názvy uložených obrázkových souborů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føjer et eller flere fotos til en genstand og genkender mærker i baggrunden. Returnerer navnene på de gemte billedfiler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt einem Gegenstand ein oder mehrere Fotos hinzu und erkennt Tags im Hintergrund. Gibt die gespeicherten Bilddateinamen zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add one or more photos to an item and recognize tags in the background. Returns the saved image file names."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add one or more photos to an item and recognize tags in the background. Returns the saved image file names."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una o varias fotos a un objeto y reconoce etiquetas en segundo plano. Devuelve los nombres de los archivos de imagen guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une ou plusieurs photos à un objet et reconnaît les étiquettes en arrière-plan. Renvoie les noms des fichiers image enregistrés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une ou plusieurs photos à un objet et reconnaît les étiquettes en arrière-plan. Renvoie les noms des fichiers image enregistrés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वस्तु में एक या अधिक फ़ोटो जोड़ता है और पृष्ठभूमि में टैग पहचानता है। सहेजे गए चित्रों की फ़ाइलों के नाम लौटाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una o più foto a un oggetto e riconosce le etichette in background. Restituisce i nomi dei file immagine salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイテムに1枚以上の写真を追加し、バックグラウンドでタグを認識します。保存した画像ファイル名を返します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een of meer foto’s aan een item toe en herkent tags op de achtergrond. Geeft de namen van de opgeslagen afbeeldingsbestanden terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje do przedmiotu co najmniej jedno zdjęcie i rozpoznaje tagi w tle. Zwraca nazwy zapisanych plików obrazów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma ou mais fotografias a um item e reconhece etiquetas em segundo plano. Devolve os nomes dos ficheiros de imagem guardados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till ett eller flera foton i ett föremål och känner igen taggar i bakgrunden. Returnerar de sparade bildfilernas namn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğeye bir veya daha fazla fotoğraf ekler ve arka planda etiketleri tanır. Kaydedilen görsel dosyalarının adlarını döndürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає одне або кілька фото до предмета та розпізнає теги у фоновому режимі. Повертає назви збережених файлів зображень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为物品添加一张或多张照片，并在后台识别标签。返回已保存图片的文件名。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為物品添加一張或多張照片，並在後台識別標籤。返回已儲存圖片的檔案名。"
          }
        }
      }
    },
