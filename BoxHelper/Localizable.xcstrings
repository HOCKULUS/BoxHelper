    "🔁 The image viewer has been redesigned. You can swipe between images, reorder them via drag and drop, delete them, and view additional image details." : {
      "comment" : "Description of an update that adds more controls and features to the image viewer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🔁 أُعيد تصميم عارض الصور. يمكنك التنقل بين الصور بالسحب، وإعادة ترتيبها بالسحب والإفلات، وحذفها، وعرض تفاصيل إضافية عنها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🔁 ইমেজ ভিউয়ার নতুনভাবে ডিজাইন করা হয়েছে। আপনি ছবির মধ্যে সোয়াইপ করতে, ড্র্যাগ-অ্যান্ড-ড্রপ দিয়ে পুনর্বিন্যাস করতে, মুছতে এবং অতিরিক্ত বিবরণ দেখতে পারবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🔁 Prohlížeč obrázků byl přepracován. Můžete mezi obrázky přejíždět, měnit jejich pořadí přetažením, mazat je a zobrazovat další podrobnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🔁 Billedfremviseren er redesignet. Du kan stryge mellem billeder, omarrangere dem via træk og slip, slette dem og se yderligere billeddetaljer."
          }
        },
        "de" : {
          "stringUnit" : {
