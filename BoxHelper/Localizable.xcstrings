    "Change an item's name while keeping its photos, tags, and box assignment." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر اسم عنصر مع الحفاظ على صوره ووسومه وتعيين صندوقه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর ছবি, ট্যাগ এবং বাক্স অ্যাসাইনমেন্ট রাখতে একটি আইটেমের নাম পরিবর্তন করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změní název položky a zachová její fotografie, štítky a přiřazení ke krabici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændrer en genstands navn og bevarer dens fotos, mærker og kassetildeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert den Namen eines Gegenstands. Fotos, Tags und Kistenzuordnung bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change an item's name while keeping its photos, tags, and box assignment."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change an item's name while keeping its photos, tags, and box assignment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el nombre de un objeto y conserva sus fotos, etiquetas y asignación a una caja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie le nom d’un objet en conservant ses photos, ses étiquettes et son affectation à une boîte."
