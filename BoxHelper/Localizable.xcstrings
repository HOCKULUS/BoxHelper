    "Launch5.Lists.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتذكر قوائمك الآن ترتيب الفرز الذي اخترته. اضبطه مرة واحدة وتابع من حيث توقفت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তালিকাগুলো এখন আপনার বেছে নেওয়া সাজানোর ক্রম মনে রাখে। একবার ঠিক করুন এবং যেখানে থেমেছিলেন সেখান থেকে শুরু করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznamy si nyní pamatují zvolené řazení. Nastav ho jednou a pokračuj tam, kde jsi skončil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine lister husker nu den valgte sortering. Indstil den én gang og fortsæt, hvor du slap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Listen merken sich jetzt die gewählte Sortierung. Einmal einstellen, beim nächsten Mal direkt weitermachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lists now remember your chosen sort order. Set it once and pick up right where you left off."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lists now remember your chosen sort order. Set it once and pick up right where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus listas recuerdan ahora el orden que elegiste. Configúralo una vez y continúa justo donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes listes mémorisent maintenant l’ordre de tri choisi. Règle-le une fois et reprends exactement où tu en étais."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes listes mémorisent maintenant l’ordre de tri choisi. Règle-le une fois et reprends exactement où tu en étais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सूचियाँ अब चुना हुआ क्रम याद रखती हैं। एक बार सेट करें और वहीं से जारी रखें जहाँ छोड़ा था।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue liste ora ricordano l’ordinamento scelto. Impostalo una volta e riprendi da dove avevi interrotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストが選択した並び順を覚えるようになりました。一度設定すれば、次回も同じ状態から続けられます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lijsten onthouden nu de gekozen sorteervolgorde. Stel deze eenmaal in en ga verder waar je gebleven was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listy pamiętają teraz wybrane sortowanie. Ustaw je raz i kontynuuj tam, gdzie przerwano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tuas listas lembram-se agora da ordenação escolhida. Define-a uma vez e continua onde ficaste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listorna minns nu din sorteringsordning. Ställ in en gång och fortsätt där du slutade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listeleriniz artık seçtiğiniz sıralamayı hatırlar. Bir kez ayarlayın ve kaldığınız yerden devam edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Списки тепер пам’ятають вибраний порядок сортування. Налаштуй один раз і продовжуй з місця зупинки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表现在会记住所选排序。设置一次，就能从上次停止的位置继续。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表現在會記住所選排序。設定一次，就能從上次停止的位置繼續。"
          }
        }
      }
    },
