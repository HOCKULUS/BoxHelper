    "All text and selected images will be removed from the saved draft." : {
      "comment" : "A message displayed in a confirmation dialog that is shown when the user deletes a feedback draft.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة كل النصوص والصور المحددة من المسودة المحفوظة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত খসড়া থেকে সব লেখা এবং নির্বাচিত ছবি মুছে ফেলা হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veškerý text a vybrané obrázky budou z uloženého konceptu odstraněny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tekst og valgte billeder fjernes fra det gemte udkast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gesamte Text und alle ausgewählten Bilder werden aus dem gespeicherten Entwurf entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All text and selected images will be removed from the saved draft."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All text and selected images will be removed from the saved draft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el texto y las imágenes seleccionadas se eliminarán del borrador guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le texte et les images sélectionnées seront supprimés du brouillon enregistré."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le texte et les images sélectionnées seront supprimés du brouillon enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव किए गए ड्राफ़्ट से सारा टेक्स्ट और चुनी गई इमेज हटा दी जाएँगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il testo e le immagini selezionate verranno rimossi dalla bozza salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
