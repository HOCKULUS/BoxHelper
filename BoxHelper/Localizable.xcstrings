    "The app feels unfinished and obvious features are missing. It seems too simple." : {
      "comment" : "Question about app being too simple",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو التطبيق غير مكتمل وهناك ميزات واضحة مفقودة. يبدو بسيطًا جدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপটি অসম্পূর্ণ মনে হয় এবং স্পষ্ট কিছু ফিচার নেই। এটি খুবই সরল মনে হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace působí nedokončeně a chybí v ní zjevné funkce. Zdá se příliš jednoduchá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen føles ufærdig, og der mangler åbenlyse funktioner. Den virker for simpel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wirkt unfertig, es fehlen offensichtliche Funktionen. Sie ist zu simpel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app feels unfinished and obvious features are missing. It seems too simple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app parece inacabada y faltan funciones obvias. Parece demasiado simple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app semble inachevée et il manque des fonctionnalités évidentes. Elle paraît trop simple."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app semble inachevée et il manque des fonctionnalités évidentes. Elle paraît trop simple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप अधूरा सा लगता है और स्पष्ट सुविधाएँ अभी गायब हैं। यह बहुत सरल प्रतीत होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app sembra incompleta e mancano funzioni ovvie. È troppo semplice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが未完成に感じられ、必要そうな機能が足りません。シンプルすぎるように見えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app voelt onaf aan en mist duidelijke functies. Het lijkt te simpel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja wydaje się niedokończona i brakuje w niej oczywistych funkcji. Wydaje się zbyt prosta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app feels unfinished and obvious features are missing. It seems too simple."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додаток здається незавершеним, і в ньому бракує очевидних функцій. Він виглядає надто простим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个 App 感觉尚未完成，明显缺少一些功能，而且看起来太简单了。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個 App 感覺尚未完成，明顯缺少一些功能，而且看起來太簡單了。"
