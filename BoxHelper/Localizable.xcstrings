    "Launch5.Dictation.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هايزنبي… أقصد، صندوق الجوارب! يسألك الوضع التلقائي عن اسم الصندوق الجديد. أمْلِ الاسم وتابع التعبئة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হাইজেনবে… উহ, মোজার বাক্স! স্বয়ংক্রিয় মোড নতুন বাক্সের নাম জানতে চায়। শুধু নাম বলুন এবং প্যাক করা চালিয়ে যান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… ehm, Krabice na ponožky! Automatický režim se zeptá na název nové krabice. Stačí ho nadiktovat a pokračovat v balení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… øh, Strømpekasse! Automatisk tilstand spørger efter et nyt kassenavn. Dikter det bare og fortsæt med at pakke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… äh, Socken-Kiste! Die Automatik fragt dich nach einem neuen Kistennamen. Einfach diktieren und weiterpacken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… uh, Sock Box! Automatic mode asks you for a new box name. Just dictate it and keep packing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… uh, Sock Box! Automatic mode asks you for a new box name. Just dictate it and keep packing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… ¡eh, Caja de calcetines! El modo automático te pide el nombre de la caja nueva. Díctalo y sigue empaquetando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… euh, Boîte à chaussettes ! Le mode automatique te demande le nom de la nouvelle boîte. Dicte-le simplement et continue à emballer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… euh, Boîte à chaussettes ! Le mode automatique te demande le nom de la nouvelle boîte. Dicte-le simplement et continue à emballer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाइज़ेनबे… अरे, मोज़ों का डिब्बा! स्वचालित मोड नए डिब्बे का नाम पूछता है। नाम बोलें और पैक करना जारी रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… ehm, Scatola dei calzini! La modalità automatica chiede il nome della nuova scatola. Basta dettarlo e continuare a imballare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイゼンベ…えっと、靴下の箱！自動モードが新しい箱の名前を尋ねます。名前を話して、そのまま荷造りを続けられます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… eh, Sokkendoos! De automatische modus vraagt naar de naam van een nieuwe doos. Dicteer deze gewoon en pak verder in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… eee, Pudełko na skarpetki! Tryb automatyczny pyta o nazwę nowego pudełka. Podyktuj ją i pakuj dalej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… hum, Caixa das meias! O modo automático pede o nome da nova caixa. Basta ditá-lo e continuar a embalar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… eh, Strumplåda! Automatiskt läge frågar efter ett nytt lådnamn. Diktera det och fortsätt packa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heisenbe… şey, Çorap Kutusu! Otomatik mod yeni kutunun adını sorar. Dikte edin ve paketlemeye devam edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гайзенбе… е-е, Коробка для шкарпеток! Автоматичний режим запитає назву нової коробки. Просто продиктуй її та продовжуй пакувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海森堡…呃，袜子箱！自动模式会询问新箱子的名称。只需说出名称，就能继续打包。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海森堡…呃，襪子箱！自動模式會詢問新箱子的名稱。只需說出名稱，就能繼續打包。"
          }
        }
      }
    },
