    "Damit ich weiß, ob sich der Aufwand, die laufenden Kosten und meine Zeit lohnen, bin ich auf dein Feedback angewiesen." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكي أعرف ما إذا كان الجهد والتكاليف المستمرة ووقتي تستحق العناء، فأنا أعتمد على ملاحظاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পরিশ্রম, চলমান খরচ এবং আমার সময় সার্থক কি না জানতে আমি আপনার মতামতের উপর নির্ভর করি।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyvíjím BoxHelper bez sledování v aplikaci, reklamy nebo externího financování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at vide, om indsatsen, de løbende omkostninger og min tid er det værd, er jeg afhængig af din feedback."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit ich weiß, ob sich der Aufwand, die laufenden Kosten und meine Zeit lohnen, bin ich auf dein Feedback angewiesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To know whether the effort, ongoing costs and my time are worth it, I rely on your feedback."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To know whether the effort, ongoing costs and my time are worth it, I rely on your feedback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollo BoxHelper sin seguimiento dentro de la app, sin publicidad y sin financiación externa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour savoir si l’effort, les coûts permanents et mon temps en valent la peine, j’ai besoin de vos retours."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour savoir si l’effort, les coûts permanents et mon temps en valent la peine, j’ai besoin de vos retours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेहनत, लगातार होने वाली लागतें और मेरा समय सार्थक हैं या नहीं, यह जानने के लिए मैं आपकी प्रतिक्रिया पर निर्भर हूँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per capire se l’impegno, i costi continui e il mio tempo valgono davvero la pena, ho bisogno del tuo feedback."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "労力、継続的なコスト、そして私の時間に見合う価値があるかを知るために、皆さんのフィードバックが必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om te weten of de inspanning, de doorlopende kosten en mijn tijd de moeite waard zijn, ben ik afhankelijk van jouw feedback."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wiedzieć, czy wysiłek, bieżące koszty i mój czas są tego warte, potrzebuję Twojej opinii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para saber se o esforço, os custos contínuos e o meu tempo valem a pena, dependo do teu feedback."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To know whether the effort, ongoing costs and my time are worth it, I rely on your feedback."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To know whether the effort, ongoing costs and my time are worth it, I rely on your feedback."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб зрозуміти, чи варті зусилля, постійні витрати та мій час, я залежу від твоїх відгуків."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了让我知道这些投入、持续成本和时间是否值得，我非常依赖你的反馈。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了了解這些投入、持續成本和我的時間是否值得，我需要你的回饋。"
