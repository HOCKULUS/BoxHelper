    "Join beta test to get early access to new features or get answers to your questions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انضم إلى الاختبار التجريبي للوصول المبكر إلى الميزات الجديدة أو للحصول على إجابات لأسئلتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন ফিচারে আগাম প্রবেশাধিকার পেতে বা আপনার প্রশ্নের উত্তর পেতে বেটা টেস্টে যোগ দিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte se k beta testu, získáte dřívější přístup k novým funkcím a odpovědi na své otázky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deltag i betatesten for at få tidlig adgang til nye funktioner eller få svar på dine spørgsmål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werde Beta-Tester oder finde Antworten auf deine Fragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join beta test to get early access to new features or get answers to your questions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join beta test to get early access to new features or get answers to your questions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participe en la fase beta u obtenga respuestas a sus preguntas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoignez le bêta-test pour accéder en avant-première aux nouvelles fonctionnalités ou obtenir des réponses à vos questions."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoignez le bêta-test pour accéder en avant-première aux nouvelles fonctionnalités ou obtenir des réponses à vos questions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई सुविधाओं तक जल्दी पहुँच पाने या अपने प्रश्नों के उत्तर पाने के लिए बीटा परीक्षण में शामिल हों।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partecipate al beta test per ottenere l'accesso anticipato alle nuove funzionalità o per ottenere le risposte alle vostre domande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベータテストに参加すると、新機能をいち早く試したり、質問への回答を得たりできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
