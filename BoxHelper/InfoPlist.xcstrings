    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج BoxHelper إلى الوصول إلى مكتبة الصور كي تتمكن من إضافة صور إلى الصناديق والعناصر والمواقع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাক্স, আইটেম ও অবস্থানে ছবি যোগ করার জন্য BoxHelper-এর আপনার ফটো লাইব্রেরিতে প্রবেশাধিকার প্রয়োজন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper potřebuje přístup k fotoknihovně, abys mohl přidávat fotografie ke krabicím, položkám a umístěním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper har brug for adgang til dit fotobibliotek, så du kan føje fotos til dine kasser, genstande og placeringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper benötigt Zugriff auf deine Fotos, damit du Fotos zu deinen Kisten hinzufügen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need access to the photo library so you can add photos to your boxes, items & locations."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need access to the photo library so you can add photos to your boxes, items & locations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos acceso a la fototeca para que puedas añadir fotos a tus cajas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons besoin d’un accès à la bibliothèque de photos afin que vous puissiez ajouter des photos à vos boîtes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper a besoin d’accéder à ta photothèque pour que tu puisses ajouter des photos à tes boîtes, objets et emplacements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिब्बों, वस्तुओं और स्थानों में फ़ोटो जोड़ने के लिए BoxHelper को आपकी फ़ोटो लाइब्रेरी की अनुमति चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper richiede l’accesso alla libreria fotografica per consentirti di aggiungere foto a scatole, oggetti e posizioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "箱、アイテム、場所に写真を追加できるように、BoxHelper は写真ライブラリへのアクセスを必要とします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper heeft toegang tot je fotobibliotheek nodig zodat je foto’s aan dozen, items en locaties kunt toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper potrzebuje dostępu do biblioteki zdjęć, aby można było dodawać zdjęcia do pudełek, przedmiotów i lokalizacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O BoxHelper precisa de acesso à tua fototeca para que possas adicionar fotografias às caixas, aos itens e às localizações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper behöver tillgång till ditt bildbibliotek så att du kan lägga till foton i lådor, föremål och platser."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper, kutulara, öğelere ve konumlara fotoğraf ekleyebilmeniz için fotoğraf arşivinize erişim gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ам потрібен доступ до фототеки, щоб ви могли додавати фотографії до своїх коробок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们需要访问照片库，以便您可以将照片添加到您的箱子中。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們需要訪問你的照片庫，以便你可以將照片添加到你的箱子中。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج BoxHelper إلى الوصول إلى الكاميرا كي تتمكن من إضافة صور إلى الصناديق والعناصر والمواقع."
