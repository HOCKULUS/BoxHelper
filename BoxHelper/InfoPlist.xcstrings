    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم BoxHelper الميكروفون لتمكينك من إملاء أسماء العناصر بعد التقاط الصور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ছবি তোলার পর আইটেমের নাম মুখে বলার সুবিধা দিতে BoxHelper মাইক্রোফোন ব্যবহার করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper používá mikrofon, abys mohl po fotografování diktovat názvy položek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper bruger mikrofonen, så du kan diktere genstandsnavne efter at have taget fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper nutzt das Mikrofon, damit du nach dem Fotografieren Gegenstandsnamen diktieren kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper uses the microphone so you can dictate item names after taking photos."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper uses the microphone so you can dictate item names after taking photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper utiliza el micrófono para que puedas dictar los nombres de los objetos después de hacer fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
