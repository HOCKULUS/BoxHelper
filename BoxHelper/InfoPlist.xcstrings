    "NSDocumentsFolderUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج BoxHelper إلى الوصول إلى ملفاتك لتتمكن من استيرادها إلى التطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপে ফাইল আমদানি করার জন্য BoxHelper-এর আপনার ফাইলে প্রবেশাধিকার প্রয়োজন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BoxHelper potřebuje přístup k tvým souborům, abys je mohl importovat do aplikace."
